 .o-gld-from{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .o-gld-msg{position:relative;margin-top:4px;padding-left:12px;font-weight:500;font-size:14px;line-height:1.45;color:rgba(245,247,250,.86);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
-.o-gld-msg i{position:absolute;left:0;top:3px;bottom:3px;width:2px;border-radius:1px;background:var(--gla);transform-origin:top}
+.o-gld-msg .o-gld-line{position:absolute;left:0;top:3px;bottom:3px;width:2px;border-radius:1px;background:var(--gla);transform-origin:top}
 @keyframes glDraw{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}
 @keyframes glLine{from{transform:scaleY(0)}to{transform:none}}
 .playing .o-gld-cc{animation:glDraw calc(.5s / var(--spd)) ease-out calc(.3s / var(--spd)) both}
 .playing .o-gld-ck{animation:glDraw calc(.36s / var(--spd)) ease-out calc(.66s / var(--spd)) both}
-.playing .o-gld-msg i{animation:glLine calc(.4s / var(--spd)) cubic-bezier(.2,.8,.2,1) calc(.5s / var(--spd)) both}
+.playing .o-gld-msg .o-gld-line{animation:glLine calc(.4s / var(--spd)) cubic-bezier(.2,.8,.2,1) calc(.5s / var(--spd)) both}
 
 /* raid — Wave */
 .o-glr{--glt:.2s}
