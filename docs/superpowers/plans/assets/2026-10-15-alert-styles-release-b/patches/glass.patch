 .o-glb-bar{position:absolute;left:22px;right:22px;bottom:11px;height:3px;border-radius:2px;background:rgba(255,255,255,.12);overflow:hidden}
-.o-glb-bar i{display:block;height:100%;border-radius:2px;background:linear-gradient(90deg,rgba(var(--gla-rgb),.55),var(--gla));transform-origin:left;box-shadow:0 0 10px rgba(var(--gla-rgb),.7)}
+.o-glb-bar .o-glb-fill{display:block;height:100%;border-radius:2px;background:linear-gradient(90deg,rgba(var(--gla-rgb),.55),var(--gla));transform-origin:left;box-shadow:0 0 10px rgba(var(--gla-rgb),.7)}
 @keyframes glGrow{from{transform:scaleX(0)}to{transform:none}}
