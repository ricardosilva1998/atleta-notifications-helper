# Atleta — environment variables.
#
# Local development: `cp .env.example .env`, fill in what you need, then `npm run dev`
# (it loads .env). Production: set them as Variables on the Railway service
# (docs/operations/deploy.md). Never commit a real .env.
#
# A line that starts with "# NAME=" is optional: the value shown is the default,
# or an example. CLAUDE.md ("Environment Variables") says what each one does.

# ── Required ─────────────────────────────────────────────────────────────────

# Discord Bot (not needed with DISCORD_DISABLED=1, below)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Twitch App (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────

APP_URL=https://your-app.up.railway.app
PORT=3000

# Signs each logged-in session's CSRF token (src/csrf.js): make one with
# `openssl rand -hex 32`. Unset, a new one is made at every boot (one warning
# at boot), and pages opened before a restart must be reloaded before they save.
CSRF_SECRET=

# Signs the /link URLs the bot hands out (src/services/linkSignature.js): make one
# with `openssl rand -hex 32`. Unset, a new one is made at every boot, and /link
# links that are still open stop working after a restart. The warning
# ("[Link] LINK_SIGNING_SECRET is not set") is logged once, the first time the secret
# is needed: when the bot comes online, or at the first /link. A log without it does
# not prove the variable is set, so check the variable itself.
LINK_SIGNING_SECRET=

# Encrypts the OAuth tokens (Twitch broadcaster, YouTube, Spotify, the bot's) and the
# StreamElements token kept in the database: 64 hex characters, made with
# `openssl rand -hex 32`. Unset, they are stored unencrypted (one warning at
# boot). Keep it safe and do not change it: tokens encrypted with another key
# cannot be read, and those streamers have to connect their accounts again.
# Roll it out in two steps: docs/operations/deploy.md.
TOKEN_ENCRYPTION_KEY=

# Discord user ids (comma-separated numbers) that are admins besides the built-in
# one (src/adminAccess.js). Names never grant admin; entries that are not ids are ignored.
# ADMIN_DISCORD_IDS=

# Read by src/config.js but used by nothing: sessions are random ids stored as hashes
# in the database, and admin access is decided by Discord id. Safe to leave unset.
# SESSION_SECRET=
# ADMIN_PASSWORD=

# ── Twitch chat bot (Atleta) ─────────────────────────────────────────────────

BOT_TWITCH_USERNAME=atleta
BOT_TWITCH_TOKEN=oauth:your_bot_token_here
# Raid protection and !slow also need the token to carry the
# moderator:manage:chat_settings scope (and the bot to be a moderator).

# Most messages the bot may post in any 30 seconds, across all channels (1-100).
# Twitch allows an ordinary account 20; raise it only if the bot's account may post more.
# BOT_CHAT_RATE_LIMIT=20

# ── YouTube ──────────────────────────────────────────────────────────────────

# Live-stream detection and the live chat bot. Without it the feed poller (RSS)
# still announces uploads, but livestreams are not detected.
# YOUTUBE_API_KEY=

# YouTube Bot (Live Chat)
YOUTUBE_BOT_REFRESH_TOKEN=
YOUTUBE_BOT_CLIENT_ID=
YOUTUBE_BOT_CLIENT_SECRET=

# ── Spotify (!song) ──────────────────────────────────────────────────────────

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── PayPal (tip pages) ───────────────────────────────────────────────────────

# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
# PAYPAL_MODE=sandbox

# ── Email (Racing password reset) ────────────────────────────────────────────

# Gmail address + App Password. Without them the self-service reset form says the
# email service is not configured (an admin can still create a reset link).
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=

# ── AI ───────────────────────────────────────────────────────────────────────

# Whisper voice-to-chat proxy for the Atleta Racing app (POST /api/bridge/whisper).
# Without it the app falls back to Windows speech recognition.
# OPENAI_API_KEY=

# AI analysis of reported issues (src/services/agentTriage.js); TRIAGE_MODEL picks the model.
# ANTHROPIC_API_KEY=
# TRIAGE_MODEL=claude-sonnet-5-5

# ── Multistream relay ────────────────────────────────────────────────────────

# Multistream is switched off until all four of these are set (docs/multistream-relay-setup.md).
# MEDIAMTX_API_URL must be an http:// or https:// address. Setting them shows the
# feature to every streamer, so set them only when the relay is up.
# MEDIAMTX_API_URL=https://relay.example.com
# MEDIAMTX_INGEST_URL=rtmp://ingest.example.com/live
# MEDIAMTX_API_TOKEN=
# MEDIAMTX_WEBHOOK_SECRET=
# Optional: the relay API login's user (admin when unset) and a Cloudflare Access service token.
# MEDIAMTX_API_USER=admin
# MEDIAMTX_CF_ACCESS_CLIENT_ID=
# MEDIAMTX_CF_ACCESS_CLIENT_SECRET=

# ── Poll intervals (milliseconds); the defaults are what production uses ─────

# TWITCH_POLL_INTERVAL=60000
# TWITCH_CLIPS_INTERVAL=300000
# YOUTUBE_FEED_INTERVAL=300000
# YOUTUBE_LIVE_INTERVAL=120000
# SUB_SYNC_INTERVAL=600000
# The weekly digest is posted in the Monday 09:00 UTC hour, up to 4 tries (first try plus
# 3 retries, at least 10 minutes apart), so the poll must tick several times in that hour:
# leave this unset (15 minutes). An hourly value means one try per week.
# WEEKLY_DIGEST_INTERVAL=900000

# ── Development and CI only ──────────────────────────────────────────────────

# Run the site without the Discord bot (no Discord login, slash commands, welcome
# messages or pollers); the three DISCORD_* variables are then not needed.
# Never set it in production.
# DISCORD_DISABLED=1

# The development environment copies production's data once a day (src/services/sync.js).
# Production serves the copy at /sync/backup to a caller that presents SYNC_SECRET;
# development sets the same SYNC_SECRET and SYNC_SOURCE_URL (production's address).
# SYNC_SOURCE_URL=
# SYNC_SECRET=
# SYNC_ON_STARTUP=true

# Atleta Racing: require bridge_id on session-upload calls. Leave unset until every
# installed app sends it.
# STRICT_SESSION_OWNERSHIP=1
