<%- include('header', { title: t('multistream.title'), streamer: streamer }) %>
<% const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); %>
<%# rich(): the translation is escaped; only the {{fields}} named in `markup` become HTML (the links, bold and code this page builds). %>
<% const rich = (key, markup = {}) => { const fields = {}; for (const name of Object.keys(markup)) fields[name] = '{{' + name + '}}'; return esc(t(key, fields)).replace(/\{\{(\w+)\}\}/g, (m, name) => (name in markup ? markup[name] : m)); }; %>

<a href="/dashboard" style="color: var(--text-secondary); font-size: 13px; font-family: var(--font-display); font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  <%= t('guild.backToDashboard') %>
</a>

<h2 style="margin: 16px 0 8px; font-size: 24px; font-weight: 700;" class="animate-in"><%= t('multistream.title') %></h2>
<p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 24px;">
  <%= t('multistream.intro') %>
</p>

<% if (typeof query !== 'undefined' && query && query.saved) { %>
  <div class="alert alert-success animate-in"><%= t('multistream.saved') %></div>
<% } %>
<% if (typeof query !== 'undefined' && query && query.reset) { %>
  <div class="alert alert-success animate-in"><%= t('multistream.resetDone') %></div>
<% } %>
<% if (typeof query !== 'undefined' && query && query.regenerated) { %>
  <div class="alert alert-success animate-in"><%= t('multistream.regenerate.done') %></div>
<% } %>
<% if (typeof query !== 'undefined' && query && query.error === 'live') { %>
  <div class="alert alert-warning animate-in"><%= t('multistream.regenerate.refusedLive') %></div>
<% } else if (typeof query !== 'undefined' && query && query.error === 'relay') { %>
  <div class="alert alert-warning animate-in"><%= t('multistream.regenerate.refusedUnknown') %></div>
<% } %>

<%# A go-live that only reached some destinations. Without this the streamer sees
    "you're live" and assumes every platform got the feed. %>
<% if (multistream.multistream_last_error) { %>
  <div class="alert alert-warning animate-in">
    <strong><%= t('multistream.lastErrorTitle') %></strong>
    <div style="margin-top: 6px; font-family: monospace; font-size: 13px;"><%= multistream.multistream_last_error %></div>
    <% if (multistream.multistream_last_error_at) { %>
      <div style="margin-top: 6px; font-size: 12px; opacity: 0.8;">
        <%= new Date(multistream.multistream_last_error_at).toLocaleString() %>
      </div>
    <% } %>
  </div>
<% } %>

<%# Live as the relay sees it (routes/multistream.js liveState). %>
<% if (isLive) { %>
  <div class="alert alert-success animate-in" style="display: flex; align-items: center; gap: 10px;">
    <span class="status-dot online"></span>
    <span><strong><%= t('multistream.liveTitle') %></strong> <%= t('multistream.liveBody') %></span>
  </div>
<% } else if (typeof liveUnknown !== 'undefined' && liveUnknown) { %>
  <div class="alert alert-warning animate-in"><%= t('multistream.liveUnknown') %></div>
<% } %>

<form method="POST" action="/dashboard/multistream/save">

  <div class="card animate-in animate-in-delay-1">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <div>
        <h3 style="margin-bottom: 0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
          <%= t('multistream.enable') %>
        </h3>
        <p style="color: var(--text-muted); font-size: 13px; margin-top: 8px;"><%= t('multistream.enableHint') %></p>
      </div>
      <label class="pill-toggle">
        <input type="checkbox" name="enabled" value="1" <%= multistream.multistream_enabled ? 'checked' : '' %>>
        <span class="slider"></span>
      </label>
    </div>
  </div>

  <div class="card animate-in animate-in-delay-2">
    <h3>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/></svg>
      <%= t('multistream.destinations') %>
    </h3>
    <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;"><%= t('multistream.destinationsHint') %></p>

    <div class="dest-card">
      <div class="dest-head">
        <div class="dest-info">
          <div class="dest-badge twitch">T</div>
          <div>
            <div class="dest-name">Twitch</div>
            <div class="dest-status">
              <% if (twitchAuthorized && twitchHasStreamKeyScope) { %>
                <span style="color: var(--success);">● <%- rich('multistream.connectedAs', { name: '<strong>' + esc(streamer.twitch_display_name || streamer.twitch_username) + '</strong>' }) %></span>
              <% } else if (twitchAuthorized) { %>
                <span style="color: var(--warning);">● <%= t('multistream.twitchMissingScope') %></span>
              <% } else { %>
                <span style="color: var(--text-muted);"><%= t('multistream.notConnected') %></span>
              <% } %>
            </div>
          </div>
        </div>
        <div>
          <% if (twitchAuthorized && twitchHasStreamKeyScope) { %>
            <a href="/auth/broadcaster" class="btn btn-secondary btn-small"><%= t('multistream.reauthorize') %></a>
          <% } else { %>
            <a href="/auth/broadcaster" class="btn btn-primary btn-small" style="background: #9146ff;"><%= t('multistream.connectTwitch') %></a>
          <% } %>
        </div>
      </div>
    </div>

    <div class="dest-card" style="margin-top: 12px;">
      <div class="dest-head">
        <div class="dest-info">
          <div class="dest-badge youtube">▶</div>
          <div>
            <div class="dest-name">YouTube</div>
            <div class="dest-status">
              <% if (youtubeConnected) { %>
                <span style="color: var(--success);">● <%- rich('multistream.connectedAs', { name: '<strong>' + esc(youtubeChannelName || t('multistream.youtubeAccount')) + '</strong>' }) %></span>
              <% } else { %>
                <span style="color: var(--text-muted);"><%= t('multistream.notConnected') %></span>
              <% } %>
            </div>
          </div>
        </div>
        <div>
          <% if (youtubeConnected) { %>
            <a href="/auth/youtube" class="btn btn-secondary btn-small"><%= t('multistream.reauthorize') %></a>
          <% } else { %>
            <a href="/auth/youtube" class="btn btn-primary btn-small" style="background: #ff0000;"><%= t('multistream.connectYoutube') %></a>
          <% } %>
        </div>
      </div>

      <% if (youtubeConnected) { %>
        <div style="border-top: 1px solid var(--border); margin-top: 16px; padding-top: 16px;">
          <p style="color: var(--text-muted); font-size: 12px; margin-bottom: 12px;"><%= t('multistream.ytDefaults') %></p>

          <div class="form-group" style="margin-bottom: 12px;">
            <label><%= t('multistream.defaultTitle') %></label>
            <input type="text" name="youtube_default_title" value="<%= multistream.multistream_youtube_default_title || '' %>" placeholder="<%= t('multistream.defaultTitlePlaceholder') %>" maxlength="100" style="width: 100%;">
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label><%= t('multistream.privacy') %></label>
              <select name="youtube_privacy" style="width: 100%;">
                <% const priv = multistream.multistream_youtube_privacy || 'public'; %>
                <option value="public" <%= priv === 'public' ? 'selected' : '' %>><%= t('multistream.privacyPublic') %></option>
                <option value="unlisted" <%= priv === 'unlisted' ? 'selected' : '' %>><%= t('multistream.privacyUnlisted') %></option>
                <option value="private" <%= priv === 'private' ? 'selected' : '' %>><%= t('multistream.privacyPrivate') %></option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label><%= t('multistream.category') %></label>
              <select name="youtube_category_id" style="width: 100%;">
                <% const cat = multistream.multistream_youtube_category_id || '20'; %>
                <option value="20" <%= cat === '20' ? 'selected' : '' %>><%= t('multistream.categoryGaming') %></option>
                <option value="22" <%= cat === '22' ? 'selected' : '' %>><%= t('multistream.categoryPeople') %></option>
                <option value="24" <%= cat === '24' ? 'selected' : '' %>><%= t('multistream.categoryEntertainment') %></option>
                <option value="17" <%= cat === '17' ? 'selected' : '' %>><%= t('multistream.categorySports') %></option>
                <option value="28" <%= cat === '28' ? 'selected' : '' %>><%= t('multistream.categoryScience') %></option>
                <option value="10" <%= cat === '10' ? 'selected' : '' %>><%= t('multistream.categoryMusic') %></option>
              </select>
            </div>
          </div>

          <% if (multistream.multistream_youtube_stream_id) { %>
            <p style="font-size: 11px; color: var(--text-muted); margin-top: 12px;">
              <%- rich('multistream.streamLinked', { a: "<a href=\"#\" onclick=\"event.preventDefault(); document.getElementById('reset-yt-form').submit();\">", aEnd: '</a>' }) %>
            </p>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card animate-in animate-in-delay-3">
    <h3>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      <%= t('multistream.obsTitle') %>
    </h3>
    <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 12px;">
      <%- rich('multistream.obsSteps', { b: '<strong>', bEnd: '</strong>' }) %>
    </p>

    <div class="form-group">
      <label><%= t('multistream.server') %></label>
      <div style="display: flex; gap: 8px;">
        <input id="ms-server" type="text" value="<%= ingestUrl %>" readonly style="flex: 1; font-family: ui-monospace, monospace; font-size: 13px;">
        <button type="button" class="btn btn-secondary" onclick="copyVal('ms-server', this)"><%= t('multistream.copy') %></button>
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 0;">
      <label><%= t('multistream.streamKey') %></label>
      <div style="display: flex; gap: 8px;">
        <input id="ms-key" type="password" value="<%= streamKey %>" readonly style="flex: 1; font-family: ui-monospace, monospace; font-size: 13px;">
        <button type="button" class="btn btn-secondary" onclick="toggleReveal('ms-key', this)"><%= t('multistream.show') %></button>
        <button type="button" class="btn btn-secondary" onclick="copyVal('ms-key', this)"><%= t('multistream.copy') %></button>
      </div>
      <p style="color: var(--text-muted); font-size: 12px; margin-top: 8px;"><%= t('multistream.keyWarning') %></p>
      <%# Submits regenerate-key-form below: a form cannot sit inside this settings form. %>
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 12px;">
        <button type="submit" form="regenerate-key-form" class="btn btn-secondary" style="flex-shrink: 0;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          <%= t('multistream.regenerate.button') %>
        </button>
        <span style="color: var(--text-muted); font-size: 12px;"><%= t('multistream.regenerate.hint') %></span>
      </div>
    </div>

    <div style="background: var(--bg-base); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px 14px; margin-top: 16px; font-size: 12px; color: var(--text-secondary); line-height: 1.6;">
      <strong style="color: var(--text-primary); font-family: var(--font-display);"><%= t('multistream.rec.title') %></strong><br>
      <%= t('multistream.rec.resolution') %>: <code>1920×1080</code> · <%= t('multistream.rec.fps') %>: <code>60</code> · <%= t('multistream.rec.encoder') %>: <code>NVENC H.264</code> (<%= t('multistream.rec.or') %> <code>x264</code>) · <%= t('multistream.rec.bitrate') %>: <code>6000 kbps</code> · <%= t('multistream.rec.keyframe') %>: <code><%= t('multistream.rec.keyframeValue') %></code> · <%= t('multistream.rec.audio') %>: <code>160 kbps AAC</code>
    </div>
  </div>

  <div style="display: flex; justify-content: flex-end; margin: 24px 0;">
    <button type="submit" class="btn btn-primary" style="padding: 12px 32px; font-size: 14px;"><%= t('multistream.saveSettings') %></button>
  </div>
</form>

<form id="reset-yt-form" method="POST" action="/dashboard/multistream/reset-youtube-stream" style="display: none;"></form>
<form id="regenerate-key-form" method="POST" action="/dashboard/multistream/regenerate-key"
      data-confirm="<%= t('multistream.regenerate.confirm') %>" onsubmit="return confirm(this.dataset.confirm)" style="display: none;"></form>

<style>
  .pill-toggle { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; }
  .pill-toggle input { opacity: 0; width: 0; height: 0; }
  .pill-toggle .slider { position: absolute; cursor: pointer; inset: 0; background: var(--bg-elevated); border-radius: 24px; border: 1px solid var(--border); transition: 0.3s; }
  .pill-toggle .slider:before { content: ''; position: absolute; height: 18px; width: 18px; left: 2px; bottom: 2px; background: #fff; border-radius: 50%; transition: 0.3s; }
  .pill-toggle input:checked + .slider { background: var(--accent); border-color: var(--accent); }
  .pill-toggle input:checked + .slider:before { transform: translateX(20px); }

  .dest-card { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px; }
  .dest-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .dest-info { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; }
  .dest-badge { width: 32px; height: 32px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-display); font-size: 16px; flex-shrink: 0; }
  .dest-badge.twitch { background: #9146ff; color: white; }
  .dest-badge.youtube { background: #ff0000; color: white; }
  .dest-name { font-weight: 600; font-size: 14px; }
  .dest-status { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
  .btn-small { padding: 7px 14px; font-size: 12px; white-space: nowrap; }
</style>

<script>
  const I18N = <%- JSON.stringify({ copied: t('multistream.copied'), show: t('multistream.show'), hide: t('multistream.hide') }).replace(/</g, '\\u003c') %>;
  function copyVal(id, btn) {
    const el = document.getElementById(id);
    navigator.clipboard.writeText(el.value);
    const orig = btn.textContent;
    btn.textContent = I18N.copied;
    setTimeout(() => btn.textContent = orig, 1500);
  }
  function toggleReveal(id, btn) {
    const el = document.getElementById(id);
    if (el.type === 'password') { el.type = 'text'; btn.textContent = I18N.hide; }
    else { el.type = 'password'; btn.textContent = I18N.show; }
  }
</script>

<%- include('footer') %>
