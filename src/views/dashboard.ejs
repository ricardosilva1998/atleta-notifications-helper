<script>
  const tabs = document.querySelectorAll('.tab-btn');
  const panes = document.querySelectorAll('.tab-content');
  // Shows a tab: <html data-dashboard-tab> (the styles at the top show its button and pane) and the marks on them.
  function switchTab(tabName) {
    document.documentElement.setAttribute('data-dashboard-tab', tabName);
    tabs.forEach(t => {
      const open = t.dataset.tab === tabName;
      t.classList.toggle('active', open);
      if (open) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current');
    });
    panes.forEach(p => p.classList.toggle('active', p.id === 'tab-' + tabName));
  }
  tabs.forEach(t => t.addEventListener('click', () => {
    switchTab(t.dataset.tab);
    try { localStorage.setItem('dashboard_tab', t.dataset.tab); } catch (e) { /* storage refused: not remembered */ }
  }));
  // The tab the script above the tab bar opened: the one picked last time, or Twitch
  switchTab(document.documentElement.getAttribute('data-dashboard-tab') || 'twitch');
</script>

