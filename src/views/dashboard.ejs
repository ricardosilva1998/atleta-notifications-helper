</script>

<style>
  .twitch-cards-grid .card { margin-bottom: 0; }
  /* Discord notifications card */
  .dn-lead { color: var(--text-secondary); font-size: 13px; margin-bottom: 12px; line-height: 1.5; }
  .dn-servers { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; margin-bottom: 14px; list-style: none; }
  .dn-server { padding: 12px; border-radius: var(--radius-sm); background: var(--bg-base); border: 1px solid var(--border); }
  .dn-server-head { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .dn-server > .dn-server-head { margin-bottom: 10px; }
  .dn-server-icon {
    width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center; background: var(--bg-elevated);
    font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--text-muted);
  }
  .dn-server-icon img { width: 28px; height: 28px; }
  .dn-server-name { flex: 1; min-width: 0; margin: 0; font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dn-offline { flex-shrink: 0; font-size: 11px; color: var(--text-secondary); }
  .dn-server-link { flex-shrink: 0; font-family: var(--font-display); font-size: 12px; font-weight: 600; }
  .dn-states { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; }
  .dn-state {
    display: inline-flex; align-items: center; gap: 5px; max-width: 100%; padding: 3px 10px;
    border: 1px solid transparent; border-radius: 999px; font-size: 12px; line-height: 1.5;
  }
  .dn-state svg { width: 12px; height: 12px; flex-shrink: 0; }
  .dn-on { background: var(--success-bg); border-color: rgba(62,207,142,0.2); color: var(--success); }
  .dn-off { background: var(--bg-elevated); color: var(--text-secondary); }
  .dn-wait { background: var(--warning-bg); border-color: rgba(247,144,9,0.25); color: var(--warning); }
  .dn-where { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: 0.85; }
  .dn-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .dn-note { margin-bottom: 12px; font-size: 12px; line-height: 1.5; color: var(--warning); }
  .dn-note a { color: var(--warning); text-decoration: underline; }
  @media (max-width: 640px) {
    .stat-tooltip { display: none !important; }
  }
  @media (max-width: 520px) {
    div[style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    div[style*="grid-template-columns: repeat(3, 1fr)"] { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    div[style*="grid-template-columns: repeat(2, 1fr)"] { grid-template-columns: minmax(0, 1fr) !important; }
    .dash-week-grid { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
    /* A server of the Discord tab: its buttons on a line of their own, under the name; three count tiles in one row */
    .dash-server-head { flex-wrap: wrap; }
    .dash-server-actions { flex-basis: 100%; }
    .dash-server-actions > * { flex: 1; justify-content: center; }
    .dash-server-meta { flex-wrap: wrap; row-gap: 2px; }
    .dash-summary[style*="repeat(3, 1fr)"] { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.tab-btn');
  const panes = document.querySelectorAll('.tab-content');
  // Shows a tab: <html data-dashboard-tab> (the styles at the top show its button and pane) and the marks on them.
  function switchTab(tabName) {
    document.documentElement.setAttribute('data-dashboard-tab', tabName);
    tabs.forEach(t => {
      const open = t.dataset.tab === tabName;
      t.classList.toggle('active', open);
      if (open) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current');
    });
    panes.forEach(p => p.classList.toggle('active', p.id === 'tab-' + tabName));
  }
  tabs.forEach(t => t.addEventListener('click', () => {
    switchTab(t.dataset.tab);
    try { localStorage.setItem('dashboard_tab', t.dataset.tab); } catch (e) { /* storage refused: not remembered */ }
  }));
  // The tab the script above the tab bar opened: the one picked last time, or Twitch
  switchTab(document.documentElement.getAttribute('data-dashboard-tab') || 'twitch');
</script>

<%- include('footer') %>
