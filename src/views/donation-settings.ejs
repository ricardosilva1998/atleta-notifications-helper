<%- include('header', { title: t('donations.settings.title'), streamer: streamer }) %>
<%
  const _lang = typeof lang !== 'undefined' ? lang : 'en';
  // A sentence with markup in the middle holds a {{name}} marker; this returns the
  // text before and after it, so the markup stays out of the translation and all of
  // it is still escaped.
  const _around = (key, name, params) => t(key, Object.assign({}, params, { [name]: '\u0001' })).split('\u0001');
  // The currency's name in the page language (the browser's own data, no keys needed)
  const _currencyName = (code) => { try { return new Intl.DisplayNames(_lang, { type: 'currency' }).of(code); } catch (e) { return code; } };
%>

<a href="/dashboard" style="color: var(--text-secondary); font-size: 13px; font-family: var(--font-display); font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  <%= t('guild.backToDashboard') %>
</a>
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin: 16px 0 8px;" class="animate-in">
  <h2 style="margin: 0; font-size: 24px; font-weight: 700;"><%= t('donations.settings.title') %></h2>
  <a href="/dashboard/donations/history" class="btn btn-secondary" style="text-decoration: none; font-size: 13px; display: inline-flex; align-items: center; gap: 6px;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg>
    <%= t('donations.history.title') %>
  </a>
</div>
<p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 24px;"><%= t(features.overlays ? 'donations.settings.intro' : 'donations.settings.introChat') %></p>

<% if (settingsError) { %>
  <div class="alert alert-danger" role="alert"><%= settingsError %></div>
<% } %>

<form method="POST" action="/dashboard/donations">
  <!-- Enable Donations -->
  <div class="card animate-in animate-in-delay-1" style="margin-bottom: 16px;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <h3>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <%= t('donations.settings.enablePage') %>
      </h3>
      <label class="pill-toggle">
        <input type="checkbox" name="donation_page_enabled" value="1" <%= streamer.donation_page_enabled ? 'checked' : '' %>>
        <span class="slider"></span>
      </label>
    </div>
    <% const _enable = _around('donations.settings.enableHint', 'url'); %>
    <p style="color: var(--text-muted); font-size: 13px; margin-top: 8px;"><%= _enable[0] %><strong>/tip/<%= streamer.twitch_username || t('donations.settings.yourUsername') %></strong><%= _enable[1] %></p>
  </div>

  <!-- PayPal Email -->
  <div class="card animate-in animate-in-delay-2" style="margin-bottom: 16px;">
    <h3>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      <%= t('donations.settings.paypalEmail') %>
    </h3>
    <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 12px;"><%= t('donations.settings.paypalHint') %></p>
    <div class="form-group" style="margin-bottom: 0;">
      <input type="email" name="paypal_email" placeholder="your-email@paypal.com" value="<%= streamer.paypal_email || '' %>" style="width: 100%;">
    </div>
  </div>

  <!-- Donation Settings -->
  <div class="card animate-in animate-in-delay-3" style="margin-bottom: 16px;">
    <h3>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      <%= t('donations.settings.settingsHeading') %>
    </h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px;">
      <div class="form-group" style="margin-bottom: 0;">
        <label><%= t('donations.settings.minAmount') %></label>
        <input type="number" name="donation_min_amount" value="<%= streamer.donation_min_amount || 1 %>" min="0.50" step="0.50" style="width: 100%;">
      </div>
      <div class="form-group" style="margin-bottom: 0;">
        <label><%= t('donations.settings.currency') %></label>
        <select name="donation_currency" style="width: 100%;">
          <option value="EUR" <%= (streamer.donation_currency || 'EUR') === 'EUR' ? 'selected' : '' %>>EUR (<%= _currencyName('EUR') %>)</option>
          <option value="USD" <%= streamer.donation_currency === 'USD' ? 'selected' : '' %>>USD (<%= _currencyName('USD') %>)</option>
          <option value="GBP" <%= streamer.donation_currency === 'GBP' ? 'selected' : '' %>>GBP (<%= _currencyName('GBP') %>)</option>
          <option value="BRL" <%= streamer.donation_currency === 'BRL' ? 'selected' : '' %>>BRL (<%= _currencyName('BRL') %>)</option>
          <option value="CAD" <%= streamer.donation_currency === 'CAD' ? 'selected' : '' %>>CAD (<%= _currencyName('CAD') %>)</option>
          <option value="AUD" <%= streamer.donation_currency === 'AUD' ? 'selected' : '' %>>AUD (<%= _currencyName('AUD') %>)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Donation Page Link -->
  <% if (streamer.paypal_email && streamer.donation_page_enabled && streamer.twitch_username) { %>
    <div class="card animate-in animate-in-delay-3" style="margin-bottom: 16px;">
      <h3>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        <%= t('donations.settings.linkHeading') %>
      </h3>
      <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 10px;"><%= t('donations.settings.linkHint') %></p>
      <div style="display: flex; gap: 8px; align-items: center;">
        <input type="text" value="<%= appUrl %>/tip/<%= streamer.twitch_username %>" readonly id="tip-url"
          style="flex: 1; padding: 10px 14px; background: var(--bg-base); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 13px;">
        <button type="button" onclick="copyField('tip-url', this)" data-copy="<%= t('donations.settings.copy') %>" data-copied="<%= t('donations.settings.copied') %>" class="btn btn-secondary" style="flex-shrink: 0;"><%= t('donations.settings.copy') %></button>
        <a href="/tip/<%= streamer.twitch_username %>" target="_blank" class="btn btn-secondary" style="flex-shrink: 0; text-decoration: none;"><%= t('donations.settings.preview') %></a>
      </div>
    </div>
  <% } %>

  <!-- Save Button -->
  <div style="display: flex; justify-content: flex-end; margin-bottom: 24px;">
    <button type="submit" class="btn btn-primary" style="padding: 12px 32px; font-size: 14px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      <%= t('donations.settings.save') %>
    </button>
  </div>
</form>

<%# Reading tips aloud (routes/dashboard.js ttsSection()): its own form, saved by POST /dashboard/donations/tts, which
    stores every field it sends (the switch is left out while it is unticked: off). Without an ElevenLabs key on the
    site it only says it is not available. The voice list and the default lines follow the language without a reload,
    and "Test the voice" reads a sample with what the form shows (POST /dashboard/donations/tts/test). A tip is read
    only through the alert overlay, so the section is hidden while the overlay features are (features.overlays). %>
<% if (features.overlays && typeof tts !== 'undefined' && tts) { const _tts = tts.settings; const _num = (n) => { try { return new Intl.NumberFormat(_lang).format(n); } catch (e) { return String(n); } }; %>
<div id="tts" class="card animate-in" style="margin-bottom: 16px;">
  <h3>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
    <%= t('donations.tts.title') %>
  </h3>
  <p style="color: var(--text-muted); font-size: 13px; margin: 8px 0 12px;"><%= t('donations.tts.intro') %></p>
  <% if (!tts.available) { %>
    <div class="alert alert-warning" role="status" style="font-size: 13px; margin-bottom: 0;"><%= t('donations.tts.unavailable') %></div>
  <% } else { %>
    <% if (ttsSaved) { %><div class="alert alert-success" role="status"><%= t('donations.tts.saved') %></div><% } %>
    <% if (ttsError) { %><div class="alert alert-danger" role="alert"><%= ttsError %></div><% } %>
    <form id="tts-form" method="POST" action="/dashboard/donations/tts">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px;">
        <label for="tts-enabled" style="font-weight: 600; font-size: 14px;"><%= t('donations.tts.enabled') %></label>
        <label class="pill-toggle">
          <input type="checkbox" name="tts_enabled" value="1" <%= _tts.enabled ? 'checked' : '' %> id="tts-enabled">
          <span class="slider"></span>
        </label>
      </div>
      <div class="tts-grid">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="tts-min"><%= t('donations.tts.minAmount') %> (<%= tts.currency %>)</label>
          <input type="number" id="tts-min" name="tts_min_amount" value="<%= _tts.minAmount %>" min="<%= tts.minFloor %>" max="10000" step="0.01" style="width: 100%;">
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="tts-language"><%= t('donations.tts.language') %></label>
          <select id="tts-language" name="tts_language" style="width: 100%;">
            <% tts.languages.forEach(function (code) { %>
              <option value="<%= code %>" lang="<%= code %>" <%= code === _tts.language ? 'selected' : '' %>><%= t('lang.' + code) %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="tts-voice"><%= t('donations.tts.voice') %></label>
          <div style="display: flex; gap: 6px;">
            <select id="tts-voice" name="tts_voice" style="flex: 1; min-width: 0;">
              <% (tts.voices[_tts.language] || []).forEach(function (voice) { %>
                <option value="<%= voice.id %>" <%= voice.id === _tts.voice ? 'selected' : '' %>><%= voice.name %></option>
              <% }) %>
            </select>
            <% const _preview = ((tts.voices[_tts.language] || []).find(function (voice) { return voice.id === _tts.voice; }) || {}).preview; %>
            <button type="button" id="tts-listen" class="btn btn-secondary" title="<%= t('donations.tts.listen') %>" aria-label="<%= t('donations.tts.listen') %>" style="flex-shrink: 0; padding: 6px 12px;"<%= _preview ? '' : ' hidden' %>>&#9654;</button>
          </div>
        </div>
      </div>
      <div class="tts-grid" style="margin-top: 16px;">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="tts-speed"><%= t('donations.tts.speed') %> <output id="tts-speed-out" for="tts-speed"><%= Number(_tts.speed).toFixed(2) %>&times;</output></label>
          <input type="range" id="tts-speed" name="tts_speed" min="0.7" max="1.2" step="0.05" value="<%= _tts.speed %>" style="width: 100%;">
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="tts-expressiveness"><%= t('donations.tts.expressiveness') %></label>
          <input type="range" id="tts-expressiveness" name="tts_expressiveness" min="0" max="1" step="0.05" value="<%= _tts.expressiveness %>" style="width: 100%;">
          <div class="tts-ends"><span><%= t('donations.tts.calm') %></span><span><%= t('donations.tts.lively') %></span></div>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="tts-volume"><%= t('donations.tts.volume') %> <output id="tts-volume-out" for="tts-volume"><%= Math.round(_tts.volume * 100) %>%</output></label>
          <input type="range" id="tts-volume" name="tts_volume" min="0" max="1" step="0.05" value="<%= _tts.volume %>" style="width: 100%;">
        </div>
      </div>
      <% const _defaults = tts.templates[_tts.language] || {}; %>
      <div class="form-group" style="margin: 16px 0 0;">
        <label for="tts-template"><%= t('donations.tts.template') %></label>
        <input type="text" id="tts-template" name="tts_template" maxlength="200" value="<%= _tts.template %>" placeholder="<%= _defaults.template %>" style="width: 100%;">
      </div>
      <div class="form-group" style="margin: 12px 0 0;">
        <label for="tts-template-empty"><%= t('donations.tts.templateEmpty') %></label>
        <input type="text" id="tts-template-empty" name="tts_template_empty" maxlength="200" value="<%= _tts.templateEmpty %>" placeholder="<%= _defaults.emptyTemplate %>" style="width: 100%;">
      </div>
      <p style="color: var(--text-muted); font-size: 12px; margin: 8px 0 0;"><%= t('donations.tts.placeholders') %> <%= t('donations.tts.banned') %></p>
      <% const _resets = (function () { try { return new Intl.DateTimeFormat(_lang, { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(tts.resetsOn + 'T00:00:00Z')); } catch (e) { return tts.resetsOn; } })(); %>
      <p style="color: var(--text-secondary); font-size: 13px; margin: 12px 0 0;"><%= t('donations.tts.usage', { used: _num(tts.used), limit: _num(tts.limit), date: _resets }) %></p>
      <% if (tts.lastError) { %>
        <p style="color: var(--warning); font-size: 12px; margin: 6px 0 0;"><%= t('donations.tts.lastError', { error: t(tts.lastError) }) %><% if (tts.lastErrorAt) { %> · <%= tts.lastErrorAt.slice(0, 16) %> UTC<% } %></p>
      <% } %>
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 16px;">
        <button type="button" id="tts-test" class="btn btn-secondary"><%= t('donations.tts.test') %></button>
        <button type="submit" class="btn btn-primary"><%= t('donations.settings.save') %></button>
      </div>
      <p id="tts-test-status" style="font-size: 12px; color: var(--text-muted); margin: 8px 0 0;" aria-live="polite"></p>
    </form>
  <% } %>
</div>
<% if (tts.available) { %>
<script>
  (function () {
    // The voices and default lines of every language, and the test's answers (routes/dashboard.js ttsSection()).
    var TTS = <%- JSON.stringify({ voices: tts.voices, templates: tts.templates, errors: tts.errorTexts }).replace(/</g, '\\u003c') %>;
    var form = document.getElementById('tts-form');
    if (!form) return;
    var language = form.elements.tts_language;
    var voice = form.elements.tts_voice;
    var listen = document.getElementById('tts-listen');
    var statusEl = document.getElementById('tts-test-status');
    var testButton = document.getElementById('tts-test');
    var playing = null;

    function play(url, volume) {
      if (playing) playing.pause();
      playing = new Audio(url);
      if (volume != null) playing.volume = Math.max(0, Math.min(1, volume));
      playing.play().catch(function () {});
    }
    function voicesOf(lang) { return TTS.voices[lang] || []; }
    function previewOf() {
      var found = voicesOf(language.value).filter(function (v) { return v.id === voice.value; })[0];
      return found ? found.preview : null;
    }
    function showListen() { listen.hidden = !previewOf(); }

    // Another language: its voices (the same voice when it has it, else its first) and its default lines.
    language.addEventListener('change', function () {
      var before = voice.value;
      voice.textContent = '';
      voicesOf(language.value).forEach(function (v) {
        var option = document.createElement('option');
        option.value = v.id;
        option.textContent = v.name;
        voice.append(option);
      });
      if (voicesOf(language.value).some(function (v) { return v.id === before; })) voice.value = before;
      var lines = TTS.templates[language.value] || {};
      form.elements.tts_template.placeholder = lines.template || '';
      form.elements.tts_template_empty.placeholder = lines.emptyTemplate || '';
      showListen();
    });
    voice.addEventListener('change', showListen);
    listen.addEventListener('click', function () { var url = previewOf(); if (url) play(url); });

    var speed = form.elements.tts_speed;
    var volume = form.elements.tts_volume;
    speed.addEventListener('input', function () { document.getElementById('tts-speed-out').textContent = Number(speed.value).toFixed(2) + '\u00d7'; });
    volume.addEventListener('input', function () { document.getElementById('tts-volume-out').textContent = Math.round(Number(volume.value) * 100) + '%'; });

    // Test the voice with what the form shows now (nothing is saved); the sample plays here at the voice volume.
    testButton.addEventListener('click', function () {
      var body = {};
      new FormData(form).forEach(function (value, key) { if (key !== '_csrf') body[key] = value; });
      testButton.disabled = true;
      statusEl.textContent = '';
      fetch('/dashboard/donations/tts/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function (res) { return res.json(); })
        .then(function (answer) {
          if (answer && answer.ok && answer.url) play(answer.url, Number(volume.value));
          else statusEl.textContent = TTS.errors[answer && answer.error] || TTS.errors.failed;
        })
        .catch(function () { statusEl.textContent = TTS.errors.failed; })
        .then(function () { testButton.disabled = false; });
    });
  })();
</script>
<% } %>
<% } %>

<%# The tip goal moved to Tracking (the Tracking card and /dashboard/tracking, views/sections/tip-goal.ejs). %>
<% if (features.overlays) { %>
<div class="card animate-in" style="margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
  <span><%= t('donations.goal.moved') %></span>
  <a href="/dashboard/tracking#tip-goal" class="btn btn-secondary"><%= t('donations.goal.movedLink') %></a>
</div>
<% } %>

<script>
  function copyField(id, btn) {
    navigator.clipboard.writeText(document.getElementById(id).value);
    btn.textContent = btn.dataset.copied;
    setTimeout(function () { btn.textContent = btn.dataset.copy; }, 1500);
  }
</script>


<style>
  .tts-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
  .tts-grid output { color: var(--text-muted); font-weight: 400; margin-left: 4px; }
  #tts-listen[hidden] { display: none; }
  .tts-ends { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); }
  .pill-toggle { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; }
  .pill-toggle input { opacity: 0; width: 0; height: 0; }
  .pill-toggle .slider { position: absolute; cursor: pointer; inset: 0; background: var(--bg-elevated); border-radius: 24px; border: 1px solid var(--border); transition: 0.3s; }
  .pill-toggle .slider:before { content: ''; position: absolute; height: 18px; width: 18px; left: 2px; bottom: 2px; background: #fff; border-radius: 50%; transition: 0.3s; }
  .pill-toggle input:checked + .slider { background: var(--accent); border-color: var(--accent); }
  .pill-toggle input:checked + .slider:before { transform: translateX(20px); }
</style>

<%- include('footer') %>
