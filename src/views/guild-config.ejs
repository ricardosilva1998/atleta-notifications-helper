<!-- ==================== TWITCH TAB ==================== -->
<div class="tab-content" id="tab-twitch">
  <div class="card animate-in">
    <h3><%= t('guild.addTwitchChannel') %></h3>
    <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 16px;">
      <%= t('guild.addTwitchDesc') %>
    </p>
    <form method="POST" action="/dashboard/guild/<%= guildId %>/channels">
      <div class="form-group">
        <label><%= t('guild.twitchUsername') %></label>
        <input type="text" name="twitch_username" placeholder="<%= t('guild.twitchUsernamePlaceholder') %>" required>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group">
          <label><%= t('guild.liveNotifications') %></label>
          <select name="live_channel_id">
            <option value=""><%= t('common.disabled') %></option>
            <% for (const c of channels) { %>
              <option value="<%= c.id %>">#<%= c.name %></option>
            <% } %>
          </select>
        </div>
        <div class="form-group">
          <label><%= t('guild.clipNotifications') %></label>
          <select name="clips_channel_id">
            <option value=""><%= t('common.disabled') %></option>
            <% for (const c of channels) { %>
              <option value="<%= c.id %>">#<%= c.name %></option>
            <% } %>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary"><%= t('guild.addChannel') %></button>
    </form>
  </div>

  <h3 class="section-title" style="margin-top: 24px;"><%= t('guild.watchedChannels') %> (<%= watchedTwitchChannels.length %>)</h3>

  <% if (watchedTwitchChannels.length === 0) { %>
    <div class="card" style="text-align: center; padding: 40px;">
      <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--accent-glow); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
      </div>
      <p style="color: var(--text-secondary); font-size: 14px;"><%= t('guild.noTwitchChannels') %></p>
    </div>
  <% } else { %>
    <% for (const wc of watchedTwitchChannels) { %>
      <div class="card" style="padding: 16px;">
        <div style="display: flex; align-items: center; gap: 14px;">
          <% if (wc.profile_image_url) { %>
            <img src="<%= wc.profile_image_url %>" alt="" style="width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;">
          <% } else { %>
            <div style="flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: var(--accent-glow); display: flex; align-items: center; justify-content: center;">
              <span style="color: var(--accent); font-family: var(--font-display); font-weight: 700; font-size: 16px;"><%= wc.twitch_username.charAt(0).toUpperCase() %></span>
            </div>
          <% } %>
          <div style="flex: 1; min-width: 0;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <a href="https://twitch.tv/<%= wc.twitch_username %>" target="_blank" style="color: var(--text-primary); font-weight: 600;"><%= wc.twitch_username %></a>
              <% if (wc.is_live) { %>
                <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; background: rgba(240,68,56,0.15); font-size: 10px; font-weight: 700; color: #f04438; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.5px;">
                  <span style="width: 6px; height: 6px; border-radius: 50%; background: #f04438; animation: pulse 1.5s infinite;"></span>
                  <%= t('guild.liveBadge') %>
                </span>
              <% } else { %>
                <span style="font-size: 10px; color: var(--text-muted);"><%= t('guild.offline') %></span>
              <% } %>
            </div>
            <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
              <% if (wc.live_channel_id) { %>
                <%= t('common.live') %>: #<%= channels.find(c => c.id === wc.live_channel_id)?.name || t('guild.unknownChannel') %>
              <% } %>
              <% if (wc.live_channel_id && wc.clips_channel_id) { %> &middot; <% } %>
              <% if (wc.clips_channel_id) { %>
                <%= t('common.clips') %>: #<%= channels.find(c => c.id === wc.clips_channel_id)?.name || t('guild.unknownChannel') %>
              <% } %>
              <% if (!wc.live_channel_id && !wc.clips_channel_id) { %><%= t('common.noNotifications') %><% } %>
            </div>
          </div>
          <div style="display: flex; gap: 6px;">
            <button onclick="toggleEdit('twitch-<%= wc.id %>')" class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px;"><%= t('guild.edit') %></button>
            <form method="POST" action="/dashboard/guild/<%= guildId %>/channels/<%= wc.id %>/remove" style="margin: 0;">
              <button type="submit" class="btn btn-danger" style="padding: 6px 12px; font-size: 12px;"><%= t('common.remove') %></button>
            </form>
          </div>
        </div>
        <!-- Edit form (hidden by default) -->
        <div id="edit-twitch-<%= wc.id %>" style="display: none; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border);">
          <form method="POST" action="/dashboard/guild/<%= guildId %>/channels/<%= wc.id %>/edit">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div class="form-group" style="margin-bottom: 12px;">
                <label><%= t('guild.liveNotifications') %></label>
                <select name="live_channel_id">
                  <option value=""><%= t('common.disabled') %></option>
                  <% for (const c of channels) { %>
                    <option value="<%= c.id %>" <%= wc.live_channel_id === c.id ? 'selected' : '' %>>#<%= c.name %></option>
                  <% } %>
                </select>
              </div>
              <div class="form-group" style="margin-bottom: 12px;">
                <label><%= t('guild.clipNotifications') %></label>
                <select name="clips_channel_id">
                  <option value=""><%= t('common.disabled') %></option>
                  <% for (const c of channels) { %>
                    <option value="<%= c.id %>" <%= wc.clips_channel_id === c.id ? 'selected' : '' %>>#<%= c.name %></option>
                  <% } %>
                </select>
              </div>
            </div>
            <div style="display: flex; gap: 8px;">
              <button type="submit" class="btn btn-success" style="padding: 7px 16px; font-size: 12px;"><%= t('guild.saveChanges') %></button>
              <button type="button" onclick="toggleEdit('twitch-<%= wc.id %>')" class="btn btn-secondary" style="padding: 7px 16px; font-size: 12px;"><%= t('guild.cancel') %></button>
            </div>
          </form>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

