        </div>
      </div>
    <% } %>
  <% } %>
</div>
<% } %>

<!-- Instagram and TikTok tabs disabled — no reliable free API available -->
<!-- ==================== DISCORD TAB ==================== -->
<div class="tab-content" id="tab-discord">
  <form method="POST" action="/dashboard/guild/<%= guildId %>">
    <!-- Hidden fields to preserve existing settings -->
    <input type="hidden" name="twitch_live_channel_id" value="<%= guild.twitch_live_channel_id || '' %>">
    <input type="hidden" name="twitch_clips_channel_id" value="<%= guild.twitch_clips_channel_id || '' %>">
    <input type="hidden" name="twitch_live_enabled" value="on">
    <input type="hidden" name="twitch_clips_enabled" value="on">
    <input type="hidden" name="youtube_channel_id" value="<%= guild.youtube_channel_id || '' %>">
    <input type="hidden" name="youtube_enabled" value="on">

    <div class="card animate-in">
      <h3><%= t('guild.welcomeMessage') %></h3>
      <div class="toggle">
        <input type="checkbox" name="welcome_enabled" id="welcome_enabled" <%= guild.welcome_enabled ? 'checked' : '' %>>
        <label for="welcome_enabled"><%= t('guild.enableWelcome') %></label>
      </div>
      <div class="form-group">
        <label><%= t('guild.sendToChannel') %></label>
        <select name="welcome_channel_id">
          <option value=""><%= t('common.selectChannel') %></option>
          <% for (const c of channels) { %>
            <option value="<%= c.id %>" <%= guild.welcome_channel_id === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% } %>
        </select>
      </div>
      <div class="form-group">
        <label><%= t('guild.customMessage') %></label>
        <textarea name="welcome_message" maxlength="<%= welcomeMessageMax %>" placeholder="<%= t('guild.welcomePlaceholder') %>"><%= guild.welcome_message || '' %></textarea>
        <p style="color: var(--text-muted); font-size: 12px; margin-top: 4px;"><%= t('guild.welcomeMessageHint', { max: welcomeMessageMax }) %></p>
      </div>
    </div>

    <div class="card">
      <h3><%= t('guild.subRoleSync') %></h3>
      <div class="toggle">
        <input type="checkbox" name="sub_sync_enabled" id="sub_sync_enabled" <%= guild.sub_sync_enabled ? 'checked' : '' %>>
        <label for="sub_sync_enabled"><%= t('guild.enableSubSync') %></label>
      </div>
      <% if (subRoleProblem) { %>
        <div class="alert alert-warning"><%= t('guild.subRoleProblem.' + subRoleProblem) %></div>
      <% } %>
      <div class="form-group">
        <label><%= t('guild.subscriberRole') %></label>
        <select name="sub_role_id">
          <option value=""><%= t('common.selectRole') %></option>
          <% for (const r of roles) { %>
            <option value="<%= r.id %>" <%= guild.sub_role_id === r.id ? 'selected' : '' %>><%= r.name %></option>
          <% } %>
        </select>
        <p style="color: var(--text-muted); font-size: 12px; margin-top: 4px;"><%= t('guild.subRoleHint') %></p>
      </div>
      <% if (!hasBroadcasterToken) { %>
        <p style="color: var(--text-secondary); font-size: 13px;"><%- t('guild.broadcasterRequiredLink', { a: '<a href="' + esc(broadcasterAuthUrl) + '">', aEnd: '</a>' }) %></p>
      <% } %>
    </div>

    <div class="card">
      <h3><%= t('guild.activityFeed') %></h3>
      <p style="color: var(--text-secondary); font-size: 13px; margin-bottom: 16px;"><%= t('guild.activityFeedDesc') %></p>

      <div class="toggle">
        <input type="checkbox" name="recap_enabled" id="recap_enabled" <%= guild.recap_enabled ? 'checked' : '' %> <% if (!limits.recaps) { %>disabled<% } %>>
        <label for="recap_enabled"><%= t('guild.streamRecaps') %></label>
      </div>
      <p style="color: var(--text-secondary); font-size: 12px; margin: -8px 0 12px 28px;"><%= t('guild.streamRecapsDesc') %></p>
      <% if (!limits.recaps) { %>
        <p style="font-size: 12px; margin: -4px 0 12px 28px;"><a href="/pricing"><%= t('guild.upgradeToEnable') %></a></p>
      <% } %>

      <div class="toggle">
        <input type="checkbox" name="milestones_enabled" id="milestones_enabled" <%= guild.milestones_enabled ? 'checked' : '' %> <% if (!limits.milestones) { %>disabled<% } %>>
        <label for="milestones_enabled"><%= t('guild.milestones') %></label>
      </div>
      <p style="color: var(--text-secondary); font-size: 12px; margin: -8px 0 12px 28px;"><%= t('guild.milestonesDesc') %></p>
      <% if (!limits.milestones) { %>
        <p style="font-size: 12px; margin: -4px 0 12px 28px;"><a href="/pricing"><%= t('guild.upgradeToEnable') %></a></p>
      <% } else if (!hasBroadcasterToken) { %>
        <p style="color: var(--warning); font-size: 12px; margin: -4px 0 12px 28px;"><%- t('guild.milestonesTokenRequiredLink', { a: '<a href="' + esc(broadcasterAuthUrl) + '">', aEnd: '</a>' }) %></p>
      <% } %>

      <div class="toggle">
        <input type="checkbox" name="weekly_highlights_enabled" id="weekly_highlights_enabled" <%= guild.weekly_highlights_enabled ? 'checked' : '' %> <% if (!limits.weeklyHighlights) { %>disabled<% } %>>
        <label for="weekly_highlights_enabled"><%= t('guild.weeklyHighlights') %></label>
      </div>
      <p style="color: var(--text-secondary); font-size: 12px; margin: -8px 0 12px 28px;"><%= t('guild.weeklyHighlightsDesc') %></p>
      <% if (!limits.weeklyHighlights) { %>
        <p style="font-size: 12px; margin: -4px 0 12px 28px;"><a href="/pricing"><%= t('guild.upgradeToEnable') %></a></p>
      <% } %>
    </div>

    <button type="submit" class="btn btn-success" style="width: 100%; padding: 14px; font-size: 15px;"><%= t('guild.saveDiscordSettings') %></button>
  </form>
</div>

<!-- ==================== iRACING TAB ==================== -->
<div class="tab-content" id="tab-iracing">
  <!-- Coming Soon -->
  <div class="card animate-in" style="text-align: center; padding: 32px 24px;">
    <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 8px;"><%= t('guild.iracingTitle') %></h3>
    <p style="color: var(--text-muted); font-size: 13px; max-width: 400px; margin: 0 auto;">
      <%= t('guild.iracingDesc') %>
    </p>
  </div>
</div>

<!-- ==================== SETTINGS TAB ==================== -->
<div class="tab-content" id="tab-settings">
  <div class="card animate-in">
    <h3><%= t('guild.serverSummary') %></h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px;">
      <div style="background: var(--bg-base); border-radius: var(--radius-sm); padding: 16px; border: 1px solid var(--border);">
        <div style="font-size: 28px; font-weight: 800; font-family: var(--font-display); color: var(--accent);"><%= watchedTwitchChannels.length %></div>
        <div style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;"><%= t('guild.twitchChannels') %></div>
      </div>
      <div style="background: var(--bg-base); border-radius: var(--radius-sm); padding: 16px; border: 1px solid var(--border);">
        <div style="font-size: 28px; font-weight: 800; font-family: var(--font-display); color: #f04438;"><%= watchedYoutubeChannels.length %></div>
        <div style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;"><%= t('guild.youtubeChannels') %></div>
      </div>
    </div>
  </div>

  <div class="card" style="border-color: rgba(240,68,56,0.2); margin-top: 8px;">
    <h3 style="color: var(--danger);"><%= t('guild.removeBot') %></h3>
    <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 16px;"><%= t('guild.removeBotDesc') %></p>
    <form method="POST" action="/dashboard/guild/<%= guildId %>/remove" data-confirm="<%= t('guild.removeConfirm') %>" onsubmit="return confirm(this.dataset.confirm)">
      <button type="submit" class="btn btn-danger"><%= t('guild.removeServer') %></button>
    </form>
  </div>
</div>

<!-- Tab switching script -->
<script>
  const tabs = document.querySelectorAll('.tab-btn');
  const panes = document.querySelectorAll('.tab-content');
  function switchTab(tabName) {
    tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabName));
    panes.forEach(p => p.classList.toggle('active', p.id === 'tab-' + tabName));
  }
  tabs.forEach(t => t.addEventListener('click', () => {
    switchTab(t.dataset.tab);
    localStorage.setItem('guildconfig_tab', t.dataset.tab);
  }));
  const savedTab = localStorage.getItem('guildconfig_tab');
  switchTab(savedTab || '<%= activeTab || "twitch" %>');

  function toggleEdit(id) {
    var el = document.getElementById('edit-' + id);
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
  }
</script>

<%- include('footer') %>
