<%# The OBS overlay card (with features.overlays; dashboardCards.js overlayCard()): the alerts' on/off switch, a test
    button per alert (its seconds follow the select below), each alert's switch and seconds, the volume, the browser
    sources for OBS folded away (masked until the eye is clicked; open while there is no link yet), and tiles to the
    Overlay Builder, the Tracking page (goal bars and trackers) and the sounds. %>
<% const linkCount = (card.url ? 1 : 0) + (card.pollBar ? 1 : 0); %>
<section class="card wc-card" id="card-overlay" data-card="overlay" aria-labelledby="card-overlay-title">
  <div class="wc-head">
    <div class="wc-icon" style="background: rgba(224,64,251,0.13); color: #e040fb"><svg class="i" aria-hidden="true"><use href="#i-monitor"/></svg></div>
    <div><h3 class="wc-title" id="card-overlay-title"><%= t('dashboard.cards.overlay.title') %></h3><span class="wc-status<%= card.status.tone === 'ok' ? '' : ' ' + card.status.tone %>" data-status><%= t(card.status.key, card.status.params) %></span></div>
    <label class="pill-toggle" title="<%= t('cards.overlay.switch') %>"><input type="checkbox" role="switch" aria-label="<%= t('cards.overlay.switch') %>" data-setting="overlay_enabled" <%= card.on ? 'checked' : '' %>><span class="slider"></span></label>
  </div>
  <div class="wc-body">
    <div class="wc-sec"><span class="wc-label"><%= t('cards.overlay.testTitle') %></span><span class="wc-count"><%= t('cards.overlay.testWhere') %></span></div>
    <div class="wc-tests<%= card.on ? '' : ' wc-dim' %>" data-dim-with="overlay_enabled">
      <% for (const a of card.alerts) { %>
      <button type="button" class="wc-test <%= a.tone %><%= a.on ? '' : ' is-off' %>" data-alert-test="<%= a.test %>" data-test-for="<%= a.switchKey %>" aria-label="<%= t('cards.overlay.testAlert') %>: <%= t(a.label) %>">
        <span class="bub"><svg class="i" aria-hidden="true"><use href="#<%= a.icon %>"/></svg></span>
        <span class="nm"><%= t(a.short) %></span>
        <small data-secs-for="<%= a.durationKey %>"><%= t('cards.common.seconds', { seconds: a.seconds }) %></small>
      </button>
      <% } %>
    </div>
    <div class="wc-sec"><span class="wc-label"><%= t('cards.overlay.alerts') %></span><span class="wc-count" data-count="alerts"><%= t(card.counts.alerts.key, card.counts.alerts.params) %></span></div>
    <div class="wc-list<%= card.on ? '' : ' wc-dim' %>" data-dim-with="overlay_enabled">
      <% for (const a of card.alerts) { %>
      <div class="wc-row wc-alert<%= a.on ? '' : ' is-off' %>">
        <label class="pill-toggle mini"><input type="checkbox" role="switch" aria-label="<%= t(a.label) %>" data-setting="<%= a.switchKey %>" <%= a.on ? 'checked' : '' %>><span class="slider"></span></label>
        <span class="nm"><%= t(a.label) %></span>
        <select class="wc-select sm" data-setting="<%= a.durationKey %>" aria-label="<%= t('cards.overlay.secondsLabel') %>: <%= t(a.label) %>"><% for (const s of a.choices) { %><option value="<%= s %>"<%= s === a.seconds ? ' selected' : '' %>><%= t('cards.common.seconds', { seconds: s }) %></option><% } %></select>
      </div>
      <% } %>
    </div>
    <div class="wc-volume"><svg class="i sm" aria-hidden="true"><use href="#i-vol"/></svg><%= t('cards.overlay.volume') %><input type="range" min="0" max="100" step="1" value="<%= card.volume %>" data-setting="overlay_volume" data-scale="100" aria-label="<%= t('cards.overlay.volume') %>"><span class="v" data-volume-label><%= card.volume %>%</span></div>
    <details class="wc-sources"<% if (card.url) { %> data-remember="overlay_sources_open"<% } else { %> open<% } %>>
      <summary><svg class="i sm" aria-hidden="true"><use href="#i-ext"/></svg><span class="tt"><%= t('cards.overlay.sources') %></span><% if (linkCount) { %><span class="wc-count"><%= linkCount === 1 ? t('cards.overlay.linkCount.one') : t('cards.overlay.linkCount.other', { count: linkCount }) %></span><% } %><svg class="i sm chev" aria-hidden="true"><use href="#i-right"/></svg></summary>
      <div class="wc-sources-body">
        <% if (card.url) { %>
        <span class="wc-label"><%= t('cards.overlay.alerts') %></span>
        <div class="wc-linkbox">
          <code class="wc-link" data-masked="<%= card.masked %>" data-shown="<%= card.shown %>"><%= card.masked %></code>
          <button type="button" class="btn btn-secondary wc-btn" data-reveal aria-pressed="false" title="<%= t('cards.overlay.reveal') %>" aria-label="<%= t('cards.overlay.reveal') %>"><svg class="i sm" aria-hidden="true"><use href="#i-eye"/></svg></button>
          <button type="button" class="btn btn-secondary wc-btn" data-copy="<%= card.url %>"><svg class="i sm" aria-hidden="true"><use href="#i-copy"/></svg><span data-copy-label><%= t('dashboard.copy') %></span></button>
        </div>
        <% } else { %>
        <div class="wc-empty"><span class="big"><svg class="i" aria-hidden="true"><use href="#i-monitor"/></svg></span><div><%= t('cards.overlay.createLinkHint') %></div></div>
        <form method="POST" action="/dashboard/overlay/generate-token" class="wc-inline-form"><button type="submit" class="btn btn-primary wc-btn block"><%= t('cards.overlay.createLink') %></button></form>
        <% } %>
        <% if (card.pollBar) { %>
        <span class="wc-label"><%= t('cards.polls.bar') %></span>
        <div class="wc-linkbox">
          <code class="wc-link" data-masked="<%= card.pollBar.masked %>" data-shown="<%= card.pollBar.shown %>"><%= card.pollBar.masked %></code>
          <button type="button" class="btn btn-secondary wc-btn" data-reveal aria-pressed="false" title="<%= t('cards.overlay.reveal') %>" aria-label="<%= t('cards.overlay.reveal') %>"><svg class="i sm" aria-hidden="true"><use href="#i-eye"/></svg></button>
          <button type="button" class="btn btn-secondary wc-btn" data-copy="<%= card.pollBar.url %>"><svg class="i sm" aria-hidden="true"><use href="#i-copy"/></svg><span data-copy-label><%= t('dashboard.copy') %></span></button>
        </div>
        <% } %>
      </div>
    </details>
    <nav class="wc-tiles" aria-label="<%= t('dashboard.cards.overlay.title') %>">
      <a class="wc-tile" href="/dashboard/overlay-builder"><svg class="i" aria-hidden="true"><use href="#i-palette"/></svg><span class="tt"><%= t('cards.overlay.look') %></span><small><%= t('cards.overlay.lookHint') %></small></a>
      <a class="wc-tile" href="/dashboard/tracking"><svg class="i" aria-hidden="true"><use href="#i-poll"/></svg><span class="tt"><%= t('tracking.title') %></span><small><%= t('cards.overlay.trackingHint') %></small></a>
      <a class="wc-tile" href="/dashboard/overlay"><svg class="i" aria-hidden="true"><use href="#i-vol"/></svg><span class="tt"><%= t('cards.overlay.sounds') %></span><small><%= t('cards.overlay.soundsHint') %></small></a>
    </nav>
  </div>
  <div class="wc-msg" data-msg hidden></div>
  <div class="wc-foot wc-foot-quiet"><span class="wc-saved" data-saved aria-hidden="true"><svg class="i sm" aria-hidden="true"><use href="#i-check"/></svg><%= t('cards.common.saved') %></span></div>
</section>
