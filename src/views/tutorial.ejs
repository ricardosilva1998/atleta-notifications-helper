<%- include('header', { title: t('nav.setupGuide'), streamer: typeof streamer !== 'undefined' ? streamer : null }) %>
<% const rich = (key) => t(key, { b: '<strong>', bEnd: '</strong>', c: '<code>', cEnd: '</code>' }); %>

<div style="max-width: 700px; margin: 0 auto;">

<h2 style="margin-bottom: 8px; text-align: center;"><%= t('nav.setupGuide') %></h2>
<p style="color: #adadb8; margin-bottom: 24px; text-align: center;"><%= t('tutorial.intro') %></p>

<div style="background: rgba(247,144,9,0.1); border: 1px solid rgba(247,144,9,0.25); border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; font-size: 13px; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f79009" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
  <span><%- rich('tutorial.notice') %></span>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">1</div><h3><%= t('tutorial.step1.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step1.p1') %></p>
    <div class="screenshot">
      <img src="/screenshots/step-1.png" alt="<%= t('tutorial.step1.alt1') %>">
    </div>
    <p><%- rich('tutorial.step1.p2') %></p>
    <div class="screenshot">
      <img src="/screenshots/step-1.1.png" alt="<%= t('tutorial.step1.alt2') %>">
    </div>
    <div class="tip"><%- rich('tutorial.step1.tip1') %></div>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">2</div><h3><%= t('tutorial.step2.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step2.p1') %></p>
    <div class="screenshot">
      <div class="icon">📸</div>
      <div class="label"><%= t('tutorial.step2.shotLabel') %></div>
      <div><%= t('tutorial.shotSoon') %></div>
    </div>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">3</div><h3><%= t('tutorial.step3.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step3.p1') %></p>
