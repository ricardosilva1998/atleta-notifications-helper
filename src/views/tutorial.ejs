    </div>
    <p><%- rich('tutorial.step5.p3') %></p>
    <div class="screenshot">
      <img src="/screenshots/step-5.2.png" alt="<%= t('tutorial.step5.alt3') %>">
    </div>
    <p><%- rich('tutorial.step5.p4') %></p>
    <div class="screenshot">
      <img src="/screenshots/step-5.3.png" alt="<%= t('tutorial.step5.alt4') %>">
    </div>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">6</div><h3><%= t('tutorial.step6.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step6.p1') %></p>
    <div class="screenshot">
      <img src="/screenshots/step-6.png" alt="<%= t('tutorial.step6.alt1') %>">
    </div>
    <p><%- rich('tutorial.step6.p2') %></p>
    <div class="screenshot">
      <img src="/screenshots/step-6.1.png" alt="<%= t('tutorial.step6.alt2') %>">
    </div>
    <div class="tip"><%- rich('tutorial.step6.tip1') %></div>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">7</div><h3><%= t('tutorial.step7.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step7.p1') %></p>
    <ul>
      <li><%- rich('tutorial.step7.li1') %></li>
      <li><%- rich('tutorial.step7.li2') %></li>
      <li><%- rich('tutorial.step7.li3') %></li>
    </ul>
    <div class="screenshot">
      <img src="/screenshots/step-7.png" alt="<%= t('tutorial.step7.alt1') %>">
