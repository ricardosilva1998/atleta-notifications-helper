<%- include('header', { title: t('nav.setupGuide'), streamer: typeof streamer !== 'undefined' ? streamer : null }) %>
<%# Every sentence on this page may have bold words and code in it: {{b}}..{{bEnd}} and {{c}}..{{cEnd}} in the text. %>
<% const MARKUP = { b: '<strong>', bEnd: '</strong>', c: '<code>', cEnd: '</code>' }; %>
<%# The YouTube step (6) is shown only while YouTube is (features.youtube); the steps after it are numbered on. %>
<% const youtube = typeof features !== 'undefined' && !!features && !!features.youtube; %>

<div style="max-width: 700px; margin: 0 auto;">

<h2 style="margin-bottom: 8px; text-align: center;"><%= t('nav.setupGuide') %></h2>
<p style="color: #adadb8; margin-bottom: 24px; text-align: center;"><%= t('tutorial.intro') %></p>

<div style="background: rgba(247,144,9,0.1); border: 1px solid rgba(247,144,9,0.25); border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; font-size: 13px; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f79009" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
  <span><%- rich('tutorial.notice', MARKUP) %></span>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">1</div><h3><%= t('tutorial.step1.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step1.p1', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-1.png" alt="<%= t('tutorial.step1.alt1') %>">
    </div>
    <p><%- rich('tutorial.step1.p2', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-1.1.png" alt="<%= t('tutorial.step1.alt2') %>">
    </div>
    <div class="tip"><%- rich('tutorial.step1.tip1', MARKUP) %></div>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">2</div><h3><%= t('tutorial.step2.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step2.p1', MARKUP) %></p>
    <div class="screenshot">
      <div class="icon">📸</div>
      <div class="label"><%= t('tutorial.step2.shotLabel') %></div>
      <div><%= t('tutorial.shotSoon') %></div>
    </div>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">3</div><h3><%= t('tutorial.step3.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step3.p1', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-3.png" alt="<%= t('tutorial.step3.alt1') %>">
    </div>
    <p><%- rich('tutorial.step3.p2', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-3.1.png" alt="<%= t('tutorial.step3.alt2') %>">
    </div>
    <ul>
      <li><%- rich('tutorial.step3.li1', MARKUP) %></li>
      <li><%- rich('tutorial.step3.li2', MARKUP) %></li>
      <li><%- rich('tutorial.step3.li3', MARKUP) %></li>
    </ul>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">4</div><h3><%= t('tutorial.step4.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step4.p1', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-4.png" alt="<%= t('tutorial.step4.alt1') %>">
    </div>
    <p><%- rich('tutorial.step4.p2', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-4.1.png" alt="<%= t(youtube ? 'tutorial.step4.alt2' : 'tutorial.step4.alt2NoYoutube') %>">
    </div>
    <div class="tip"><%- rich('tutorial.step4.tip1', MARKUP) %></div>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number">5</div><h3><%= t('tutorial.step5.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step5.p1', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-5.png" alt="<%= t(youtube ? 'tutorial.step5.alt1' : 'tutorial.step5.alt1NoYoutube') %>">
    </div>
    <p><%- rich('tutorial.step5.p2', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-5.1.png" alt="<%= t('tutorial.step5.alt2') %>">
    </div>
    <p><%- rich('tutorial.step5.p3', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-5.2.png" alt="<%= t('tutorial.step5.alt3') %>">
    </div>
    <p><%- rich('tutorial.step5.p4', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-5.3.png" alt="<%= t('tutorial.step5.alt4') %>">
    </div>
  </div>
</div>

<% if (youtube) { %>
<div class="step">
  <div class="step-header"><div class="step-number">6</div><h3><%= t('tutorial.step6.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step6.p1', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-6.png" alt="<%= t('tutorial.step6.alt1') %>">
    </div>
    <p><%- rich('tutorial.step6.p2', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-6.1.png" alt="<%= t('tutorial.step6.alt2') %>">
    </div>
    <div class="tip"><%- rich('tutorial.step6.tip1', MARKUP) %></div>
  </div>
</div>
<% } %>

<div class="step">
  <div class="step-header"><div class="step-number"><%= youtube ? 7 : 6 %></div><h3><%= t('tutorial.step7.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step7.p1', MARKUP) %></p>
    <ul>
      <li><%- rich('tutorial.step7.li1', MARKUP) %></li>
      <li><%- rich('tutorial.step7.li2', MARKUP) %></li>
      <li><%- rich('tutorial.step7.li3', MARKUP) %></li>
    </ul>
    <div class="screenshot">
      <img src="/screenshots/step-7.png" alt="<%= t('tutorial.step7.alt1') %>">
    </div>
  </div>
</div>

<div class="step">
  <div class="step-header"><div class="step-number"><%= youtube ? 8 : 7 %></div><h3><%= t('tutorial.step8.title') %></h3></div>
  <div class="step-content">
    <p><%- rich('tutorial.step8.p1', MARKUP) %></p>

    <p><%- rich('tutorial.step8.p2', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-8.png" alt="<%= t('tutorial.step8.alt1') %>">
    </div>

    <p><%- rich('tutorial.step8.p3', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-8.1.png" alt="<%= t('tutorial.step8.alt2') %>">
    </div>

    <p><%- rich('tutorial.step8.p4', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-8.2.png" alt="<%= t('tutorial.step8.alt3') %>">
    </div>

    <p><%- rich('tutorial.step8.p5', MARKUP) %></p>
    <div class="screenshot">
      <img src="/screenshots/step-8.3.png" alt="<%= t('tutorial.step8.alt4') %>">
    </div>

    <div class="tip"><%- rich('tutorial.step8.tip1', MARKUP) %></div>
  </div>
</div>

<div class="card" style="margin-top: 32px; text-align: center;">
  <h3 style="margin-bottom: 8px;"><%= t('tutorial.ready') %></h3>
  <p style="color: #adadb8; margin-bottom: 16px;"><%= t('tutorial.readyHint') %></p>
  <a href="/auth/login" class="btn btn-discord" style="font-size: 16px; padding: 12px 24px;"><%= t('tutorial.login') %></a>
</div>

</div>

<%- include('footer') %>
