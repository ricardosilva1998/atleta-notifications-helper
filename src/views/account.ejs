<%- include('header', { title: t('nav.account'), streamer: streamer }) %>

<a href="/dashboard" style="color: var(--text-secondary); font-size: 13px; font-family: var(--font-display); font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  <%= t('guild.backToDashboard') %>
</a>

<!-- Profile Header -->
<div style="display: flex; align-items: center; gap: 16px; margin: 20px 0 32px;" class="animate-in">
  <div style="position: relative; cursor: pointer;" id="avatar-wrapper" onclick="document.getElementById('avatar-input').click()">
    <% const avatarUrl = streamer.profile_picture ? '/avatars/' + streamer.id + '/' + streamer.profile_picture : streamer.discord_avatar; %>
    <% if (avatarUrl) { %>
      <img src="<%= avatarUrl %>" alt="" id="avatar-img" style="width: 56px; height: 56px; border-radius: 50%; border: 3px solid var(--border); object-fit: cover;">
    <% } else { %>
      <div id="avatar-img" style="width: 56px; height: 56px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; color: white; font-family: var(--font-display); font-weight: 700; font-size: 22px;"><%= (streamer.discord_display_name || streamer.discord_username || '?').charAt(0).toUpperCase() %></div>
    <% } %>
    <div style="position: absolute; inset: 0; border-radius: 50%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
    </div>
    <input type="file" id="avatar-input" accept="image/jpeg,image/png,image/gif,image/webp" style="display: none;" onchange="uploadAvatar(this)">
  </div>
  <div>
    <h2 style="font-size: 22px; font-weight: 700; margin-bottom: 4px;"><%= streamer.discord_display_name || streamer.discord_username %></h2>
    <div style="display: flex; align-items: center; gap: 8px;">
      <span class="badge badge-tier"><%= tier.toUpperCase() %></span>
      <span style="color: var(--text-muted); font-size: 13px;"><%= t('account.memberSince', { date: streamer.created_at ? streamer.created_at.split('T')[0] : t('account.notAvailable') }) %></span>
      <% if (streamer.profile_picture) { %>
        <a href="#" id="remove-avatar-link" onclick="removeAvatar(); return false;" style="font-size: 12px; color: var(--danger); margin-left: 4px;"><%= t('account.removePhoto') %></a>
      <% } %>
    </div>
  </div>
</div>

<!-- Overview Cards -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px;" class="animate-in animate-in-delay-1">
  <div class="card" style="text-align: center; padding: 20px 12px;">
    <div style="font-size: 28px; font-weight: 800; font-family: var(--font-display); color: var(--accent);"><%= stats.total_notifications %></div>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;"><%= t('account.stats.total') %></div>
  </div>
  <div class="card" style="text-align: center; padding: 20px 12px;">
    <div style="font-size: 28px; font-weight: 800; font-family: var(--font-display); color: var(--success);"><%= stats.notifications_today %></div>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;"><%= t('account.stats.today') %></div>
  </div>
  <div class="card" style="text-align: center; padding: 20px 12px;">
    <div style="font-size: 28px; font-weight: 800; font-family: var(--font-display); color: var(--text-primary);"><%= stats.notifications_week %></div>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;"><%= t('account.stats.week') %></div>
  </div>
  <div class="card" style="text-align: center; padding: 20px 12px;">
    <div style="font-size: 28px; font-weight: 800; font-family: var(--font-display); color: var(--text-primary);"><%= stats.notifications_month %></div>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;"><%= t('account.stats.month') %></div>
  </div>
</div>

<!-- Charts Row -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 24px;" class="animate-in animate-in-delay-2">
  <!-- Notifications Over Time -->
  <div class="card" style="padding: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="font-size: 15px; margin: 0;"><%= t('account.chart.title') %></h3>
    </div>
    <% if (notificationsOverTime.length === 0) { %>
      <div style="text-align: center; padding: 30px 0; color: var(--text-muted); font-size: 13px;"><%= t('account.chart.empty') %></div>
    <% } else { %>
      <% const maxCount = Math.max(...notificationsOverTime.map(d => d.count), 1); %>
      <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
        <span style="font-size: 9px; color: var(--text-muted);"><%= maxCount %></span>
        <span style="font-size: 9px; color: var(--text-muted);"><%= t('account.chart.axis') %></span>
      </div>
      <div style="display: flex; align-items: flex-end; gap: 2px; height: 120px; position: relative;">
        <% notificationsOverTime.forEach(function(d) { %>
          <div style="flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; cursor: default;" title="<%= t(d.count === 1 ? 'account.chart.tooltipOne' : 'account.chart.tooltipMany', { period: d.period, count: d.count }) %>">
            <div style="width: 100%; background: var(--accent); border-radius: 2px 2px 0 0; height: <%= Math.round(Math.max((d.count / maxCount) * 120, d.count > 0 ? 3 : 1)) %>px; opacity: <%= d.count > 0 ? 1 : 0.12 %>;"></div>
          </div>
        <% }); %>
      </div>
      <div style="display: flex; justify-content: space-between; margin-top: 8px;">
        <span style="font-size: 10px; color: var(--text-muted);"><%= notificationsOverTime[0].period %></span>
        <% if (notificationsOverTime.length > 10) { %>
          <span style="font-size: 10px; color: var(--text-muted);"><%= notificationsOverTime[Math.floor(notificationsOverTime.length / 2)].period %></span>
        <% } %>
        <span style="font-size: 10px; color: var(--text-muted);"><%= notificationsOverTime[notificationsOverTime.length - 1].period %></span>
      </div>
    <% } %>
  </div>

  <!-- By Type -->
  <div class="card" style="padding: 24px;">
    <h3 style="font-size: 15px; margin-bottom: 20px;"><%= t('account.byType') %></h3>
    <%# The YouTube posts are left out while YouTube is hidden (features.youtube); they are still in the totals. %>
    <% const _byType = notificationsByType.filter(function(d) { return features.youtube || String(d.type).indexOf('youtube_') !== 0; }); %>
    <% if (_byType.length === 0) { %>
      <p style="color: var(--text-muted); font-size: 13px;"><%= t('account.chart.empty') %></p>
    <% } else { %>
      <% const typeColors = { twitch_live: '#9146ff', twitch_clip: '#bf94ff', twitch_recap: '#6d28d9', youtube_video: '#f04438', youtube_live: '#ff6b6b', weekly_digest: '#3498db', twitch_milestone: '#f1c40f' }; %>
      <% const typeLabels = { twitch_live: t('account.type.twitchLive'), twitch_clip: t('account.type.twitchClip'), twitch_recap: t('account.type.twitchRecap'), weekly_digest: t('account.type.weeklyDigest'), twitch_milestone: t('account.type.twitchMilestone') }; %>
      <% if (features.youtube) Object.assign(typeLabels, { youtube_video: t('account.type.youtubeVideo'), youtube_live: t('account.type.youtubeLive') }); %>
      <% const totalByType = _byType.reduce((s, d) => s + d.count, 0); %>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <% _byType.forEach(function(d) { %>
          <div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
              <span style="font-size: 12px; color: var(--text-secondary);"><%= typeLabels[d.type] || d.type %></span>
              <span style="font-size: 12px; color: var(--text-muted);"><%= d.count %></span>
            </div>
            <div style="width: 100%; height: 6px; background: var(--bg-base); border-radius: 3px; overflow: hidden;">
              <div style="width: <%= (d.count / totalByType * 100) %>%; height: 100%; background: <%= typeColors[d.type] || 'var(--accent)' %>; border-radius: 3px;"></div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<!-- Detailed Breakdown -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;" class="animate-in animate-in-delay-2">
  <div class="card" style="padding: 20px;">
    <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 12px; font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;"><%= t('account.resources') %></div>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
      <div style="background: var(--bg-base); border-radius: var(--radius-sm); padding: 14px; border: 1px solid var(--border);">
        <div style="font-size: 20px; font-weight: 700; font-family: var(--font-display);"><%= stats.total_guilds %></div>
        <div style="font-size: 11px; color: var(--text-muted);"><%= t('account.servers') %></div>
      </div>
      <div style="background: var(--bg-base); border-radius: var(--radius-sm); padding: 14px; border: 1px solid var(--border);">
        <div style="font-size: 20px; font-weight: 700; font-family: var(--font-display);"><%= stats.total_twitch_channels %></div>
        <div style="font-size: 11px; color: var(--text-muted);"><%= t('guild.twitchChannels') %></div>
      </div>
      <% if (features.youtube) { %>
      <div style="background: var(--bg-base); border-radius: var(--radius-sm); padding: 14px; border: 1px solid var(--border);">
        <div style="font-size: 20px; font-weight: 700; font-family: var(--font-display);"><%= stats.total_youtube_channels %></div>
        <div style="font-size: 11px; color: var(--text-muted);"><%= t('guild.youtubeChannels') %></div>
      </div>
      <% } %>
      <div style="background: var(--bg-base); border-radius: var(--radius-sm); padding: 14px; border: 1px solid var(--border);<%= features.youtube ? '' : ' grid-column: 1 / -1;' %>">
        <div style="font-size: 20px; font-weight: 700; font-family: var(--font-display); color: var(--success);"><%= stats.notifications_week %></div>
        <div style="font-size: 11px; color: var(--text-muted);"><%= t('account.stats.week') %></div>
      </div>
    </div>
  </div>
  <div class="card" style="padding: 20px;">
    <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 12px; font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;"><%= t('account.quickActions') %></div>

    <div style="padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--border); margin-bottom: 8px;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <div style="font-size: 13px; font-weight: 600;"><%= t('nav.language') %></div>
        </div>
        <form method="POST" action="/set-language" style="margin: 0;">
          <select name="lang" onchange="this.form.submit()" style="padding: 5px 8px; background: var(--bg-base); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 12px; cursor: pointer;">
            <% SUPPORTED_LANGS.forEach(function(l) { %>
              <option value="<%= l %>" <%= l === lang ? 'selected' : '' %>><%= t('lang.' + l) %></option>
            <% }); %>
          </select>
        </form>
      </div>
    </div>

    <form method="POST" action="/auth/logout" style="margin: 0;">
      <button type="submit" style="display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px; border-radius: var(--radius-sm); border: 1px solid rgba(240,68,56,0.15); background: none; color: var(--danger); font: inherit; text-align: left; cursor: pointer; transition: all 0.2s;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        <div style="font-size: 13px; font-weight: 600;"><%= t('nav.logout') %></div>
      </button>
    </form>
  </div>
</div>

<!-- Feedback -->
<div class="card animate-in animate-in-delay-4" style="margin-bottom: 16px;">
  <h3 style="font-size: 15px; margin-bottom: 4px;"><%= t('account.feedback.title') %></h3>
  <p style="color: var(--text-secondary); font-size: 13px; margin-bottom: 14px;"><%= t('account.feedback.subtitle') %></p>
  <% if (typeof feedbackMsg !== 'undefined' && feedbackMsg === 'submitted') { %>
    <div class="alert alert-success" style="margin-bottom: 12px;"><%= t('account.feedback.thanks') %></div>
  <% } %>
  <form method="POST" action="/dashboard/feedback">
    <div style="margin-bottom: 12px;">
      <label style="font-size: 13px; color: var(--text-secondary); display: block; margin-bottom: 6px;"><%= t('account.feedback.rating') %></label>
      <div style="display: flex; gap: 4px;" id="star-rating">
        <% for (let i = 1; i <= 5; i++) { %>
          <label style="cursor: pointer; font-size: 28px; color: var(--text-muted); transition: color 0.15s;" onmouseover="highlightStars(<%= i %>)" onmouseout="resetStars()">
            <input type="radio" name="rating" value="<%= i %>" required style="display: none;">
            <span class="star" data-value="<%= i %>">&#9733;</span>
          </label>
        <% } %>
      </div>
    </div>
    <div class="form-group" style="margin-bottom: 12px;">
      <label><%= t('account.feedback.label') %></label>
      <textarea name="message" placeholder="<%= t('account.feedback.placeholder') %>" required style="min-height: 80px;"></textarea>
    </div>
    <button type="submit" class="btn btn-primary" style="padding: 8px 20px; font-size: 13px;"><%= t('account.feedback.submit') %></button>
  </form>
</div>

<script>
  var I18N = <%- JSON.stringify({
    tooLarge: t('account.js.tooLarge'), uploadFailed: t('account.js.uploadFailed'), removeFailed: t('account.js.removeFailed'), removePhoto: t('account.removePhoto'),
  }).replace(/</g, '\\u003c') %>;
  var selectedRating = 0;
  function highlightStars(n) {
    document.querySelectorAll('#star-rating .star').forEach(function(s) {
      s.style.color = parseInt(s.dataset.value) <= n ? '#f1c40f' : 'var(--text-muted)';
    });
  }
  function resetStars() {
    document.querySelectorAll('#star-rating .star').forEach(function(s) {
      s.style.color = parseInt(s.dataset.value) <= selectedRating ? '#f1c40f' : 'var(--text-muted)';
    });
  }
  document.querySelectorAll('#star-rating input').forEach(function(input) {
    input.addEventListener('change', function() {
      selectedRating = parseInt(this.value);
      highlightStars(selectedRating);
    });
  });

  async function uploadAvatar(input) {
    var file = input.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert(I18N.tooLarge); input.value = ''; return; }
    var ext = file.name.split('.').pop().toLowerCase();
    try {
      var res = await fetch('/dashboard/account/avatar?ext=' + encodeURIComponent(ext), { method: 'POST', body: file });
      var data = await res.json();
      if (data.ok) {
        var wrapper = document.getElementById('avatar-wrapper');
        var old = document.getElementById('avatar-img');
        var img = document.createElement('img');
        img.id = 'avatar-img';
        img.src = data.url + '?t=' + Date.now();
        img.alt = '';
        img.style.cssText = 'width: 56px; height: 56px; border-radius: 50%; border: 3px solid var(--border); object-fit: cover;';
        if (old) old.replaceWith(img);
        // Show remove link
        if (!document.getElementById('remove-avatar-link')) {
          var link = document.createElement('a');
          link.id = 'remove-avatar-link';
          link.href = '#';
          link.onclick = function() { removeAvatar(); return false; };
          link.style.cssText = 'font-size: 12px; color: var(--danger); margin-left: 4px;';
          link.textContent = I18N.removePhoto;
          document.querySelector('.badge-tier').parentElement.appendChild(link);
        }
        // Also update nav avatar
        var navAvatar = document.querySelector('.nav-avatar');
        if (navAvatar) { navAvatar.src = data.url + '?t=' + Date.now(); }
      } else { alert(res.status === 413 ? I18N.tooLarge : (data.error || I18N.uploadFailed)); }
    } catch(e) { alert(I18N.uploadFailed); }
    input.value = '';
  }

  async function removeAvatar() {
    try {
      var res = await fetch('/dashboard/account/avatar', { method: 'DELETE' });
      var data = await res.json();
      if (data.ok) { location.reload(); }
    } catch(e) { alert(I18N.removeFailed); }
  }
</script>

<style>
  @media (max-width: 640px) {
    div[style*="grid-template-columns: repeat(4"] { grid-template-columns: repeat(2, 1fr) !important; }
    div[style*="grid-template-columns: 2fr 1fr"] { grid-template-columns: 1fr !important; }
    div[style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>

<%- include('footer') %>
