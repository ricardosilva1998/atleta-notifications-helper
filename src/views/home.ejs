<%- include('header', { title: t('home.pageTitle'), streamer: typeof streamer !== 'undefined' ? streamer : null }) %>
<%#
  The home page (GET / in server.js): what the streamer tools do. It names neither Racing (the route leaves the
  header's Racing menu out) nor the OBS-overlay features. What it says about YouTube follows features.youtube; the
  YouTube go-live posts also need the API key (youtubeLive, from the route).
%>
<%
  const loggedIn = typeof streamer !== 'undefined' && !!streamer;
  const youtube = typeof features !== 'undefined' && !!features && !!features.youtube;
  const youtubeGoLive = youtube && typeof youtubeLive !== 'undefined' && !!youtubeLive;

  // The call to action, in the hero and at the end: log in, or go to the dashboard.
  const DISCORD_LOGO = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>';
  const cta = loggedIn
    ? { href: '/dashboard', className: 'btn btn-primary', icon: '<i data-lucide="layout-dashboard" aria-hidden="true"></i>', label: t('home.cta.openDashboard') }
    : { href: '/auth/login', className: 'btn btn-discord', icon: DISCORD_LOGO, label: t('landing.loginDiscord') };

  // The feature cards: an icon, a colour (home-tone-*), a title and the lines under it. The first card is the
  // widest: Discord notifications are what the site started as.
  const cards = [
    { icon: 'bell-ring', tone: 'discord', wide: true, title: 'home.notify.title', items: [
      youtubeGoLive ? 'home.notify.goLiveYoutube' : 'home.notify.goLive',
      youtube ? 'home.notify.clipsYoutube' : 'home.notify.clips',
      'home.notify.recap',
      'home.notify.highlights',
    ] },
    { icon: 'users', tone: 'discord', title: 'home.community.title', items: ['home.community.welcome', 'home.community.subRole', 'home.community.subRoleSync'] },
    { icon: 'bot-message-square', tone: 'twitch', title: 'home.twitchBot.title', items: ['home.twitchBot.thanks', 'home.twitchBot.commands', 'home.twitchBot.song', 'home.twitchBot.sponsors'] },
    { icon: 'shield-check', tone: 'moderation', title: 'home.moderation.title', items: ['home.moderation.words', 'home.moderation.filters', 'home.moderation.escalation', 'home.moderation.log'] },
    { icon: 'gift', tone: 'giveaways', title: 'home.giveaways.title', items: ['home.giveaways.keyword', 'home.giveaways.subsOnly', 'home.giveaways.winners', 'home.giveaways.chat'] },
    { icon: 'hand-coins', tone: 'paypal', title: 'home.tips.title', items: ['home.tips.page', 'home.tips.direct', 'home.tips.thanks', 'home.tips.history'] },
  ];
  if (youtube) {
    cards.push({ icon: 'messages-square', tone: 'youtube', title: 'home.youtubeBot.title', items: ['home.youtubeBot.thanks', 'home.youtubeBot.commands', 'home.youtubeBot.moderation'] });
  }
  // The cards after the first go two to a row; one left alone in the last row is as wide as the first.
  if ((cards.length - 1) % 2 === 1) cards[cards.length - 1].wide = true;

  const steps = [
    ['home.how.step1.title', 'home.how.step1.text'],
    ['home.how.step2.title', 'home.how.step2.text'],
    ['home.how.step3.title', 'home.how.step3.text'],
  ];
%>

<style>
  /* auto-phrase: Japanese lines break between phrases, not inside a word (Chromium; elsewhere as normal) */
  .home { padding-bottom: 8px; word-break: auto-phrase; }
  .home :focus-visible { outline: 2px solid var(--accent-hover); outline-offset: 3px; }

  /* Hero */
  .home-hero { position: relative; isolation: isolate; text-align: center; padding: 40px 0 4px; }
  /* The glow fades out before the container's edges (46% of its width each side of the middle) */
  .home-hero::before {
    content: ''; position: absolute; z-index: -1; left: 0; right: 0; top: -32px; height: 360px; pointer-events: none;
    background: radial-gradient(ellipse 46% 78% at 50% 0%, rgba(145,70,255,0.24), rgba(145,70,255,0) 100%);
  }
  .home-badge {
    display: inline-flex; align-items: center; gap: 8px; max-width: 100%; margin-bottom: 22px; padding: 6px 14px; border-radius: 16px;
    background: var(--accent-glow); border: 1px solid rgba(145,70,255,0.2); color: var(--accent-hover);
    font-family: var(--font-display); font-size: 12px; font-weight: 600; line-height: 1.4;
  }
  .home-badge svg { width: 14px; height: 14px; flex-shrink: 0; }
  .home-title {
    max-width: 760px; margin: 0 auto 18px; font-size: clamp(31px, 5.2vw, 50px); font-weight: 800;
    line-height: 1.08; letter-spacing: -0.03em; overflow-wrap: break-word; text-wrap: balance;
  }
  /* inline-block: the platforms stay together on one line when they fit */
  .home-title-accent {
    display: inline-block; max-width: 100%;
    background: linear-gradient(135deg, var(--accent-hover), #d946ef); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .home-lead { max-width: 580px; margin: 0 auto 28px; color: var(--text-secondary); font-size: 17px; line-height: 1.6; text-wrap: balance; }
  .home-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .home-actions .btn { padding: 12px 24px; font-size: 15px; }
  .home-actions .btn svg { width: 18px; height: 18px; flex-shrink: 0; }

  /* Sections */
  .home-section { margin-top: 72px; }
  .home-section-head { max-width: 620px; margin: 0 auto 28px; text-align: center; }
  .home-section-head h2, .home-closing h2 { margin-bottom: 8px; font-size: clamp(24px, 3.2vw, 30px); font-weight: 700; text-wrap: balance; }
  .home-section-head p { color: var(--text-secondary); font-size: 15px; line-height: 1.6; text-wrap: balance; }

  /* Feature cards: two columns; a wide card (the first, or one left alone in the last row) spans both */
  .home-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .home-card {
    display: flex; flex-direction: column; gap: 16px; margin: 0; padding: 22px;
    background-image: radial-gradient(130% 90% at 0% 0%, var(--tone-soft), transparent 58%);
  }
  .home-card-wide { grid-column: 1 / -1; }
  .home-card-head { display: flex; align-items: center; gap: 12px; }
  .home-card .home-card-head h3 { margin: 0; font-size: 17px; font-weight: 600; }
  .home-icon {
    display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 42px; height: 42px;
    border-radius: 12px; background: var(--tone-soft); color: var(--tone);
  }
  .home-icon svg { width: 21px; height: 21px; }
  .home-list { display: grid; gap: 10px; list-style: none; }
  .home-card-wide .home-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; }
  .home-list li { display: flex; align-items: flex-start; gap: 10px; color: var(--text-secondary); font-size: 14px; line-height: 1.5; overflow-wrap: break-word; text-wrap: pretty; }
  .home-list li > span { min-width: 0; }
  .home-list svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; color: var(--tone); }
  .home-tone-discord { --tone: #8b93f8; --tone-soft: rgba(88,101,242,0.16); }
  .home-tone-twitch { --tone: #b282ff; --tone-soft: rgba(145,70,255,0.16); }
  .home-tone-moderation { --tone: #3ecf8e; --tone-soft: rgba(62,207,142,0.13); }
  .home-tone-giveaways { --tone: #f9a43d; --tone-soft: rgba(247,144,9,0.14); }
  .home-tone-paypal { --tone: #45b8ef; --tone-soft: rgba(0,156,222,0.15); }
  .home-tone-youtube { --tone: #ff6b6b; --tone-soft: rgba(255,0,0,0.13); }

  /* How it works */
  .home-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; list-style: none; }
  .home-step { margin: 0; padding: 22px; }
  .home-step .step-number { margin-bottom: 14px; }
  .home-step h3 { display: block; margin: 0 0 6px; font-size: 16px; font-weight: 600; }
  .home-step p { color: var(--text-secondary); font-size: 14px; line-height: 1.55; text-wrap: pretty; }
  .home-guide { margin-top: 20px; text-align: center; }
  .home-guide a { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-display); font-size: 14px; font-weight: 600; }
  .home-guide svg { width: 16px; height: 16px; }

  /* Closing call to action */
  .home-closing {
    margin-top: 72px; padding: 40px 24px; border-radius: var(--radius-lg); border: 1px solid rgba(145,70,255,0.22); text-align: center;
    background: radial-gradient(ellipse 70% 90% at 50% 0%, rgba(145,70,255,0.16), rgba(145,70,255,0) 100%), var(--bg-surface);
  }
  .home-closing p { max-width: 480px; margin: 0 auto 24px; color: var(--text-secondary); font-size: 15px; line-height: 1.6; text-wrap: balance; }

  /* Language */
  .home-lang { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 4px; margin: 40px 0 0; }
  .home-lang-label {
    display: inline-flex; align-items: center; gap: 6px; margin-right: 6px;
    color: var(--text-secondary); font-family: var(--font-display); font-size: 13px; font-weight: 600;
  }
  .home-lang-label svg { width: 15px; height: 15px; }
  .home-lang-btn {
    padding: 6px 10px; border: 1px solid transparent; border-radius: 999px; background: none; cursor: pointer;
    color: var(--text-secondary); font-family: var(--font-body); font-size: 13px; transition: all var(--transition);
  }
  .home-lang-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
  .home-lang-btn[aria-current="true"] { border-color: var(--border-focus); background: var(--accent-glow); color: var(--text-primary); }

  @media (max-width: 640px) {
    .home-hero { padding-top: 16px; }
    .home-lead { font-size: 16px; }
    .home-section, .home-closing { margin-top: 56px; }
    .home-grid, .home-steps, .home-card-wide .home-list { grid-template-columns: minmax(0, 1fr); }
    /* a step's number beside its title and text */
    .home-step { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 14px; align-items: start; padding: 18px; }
    .home-step .step-number { grid-row: 1 / span 2; margin: 0; }
    .home-step h3 { margin-top: 5px; }
    .home-closing { padding: 32px 18px; }
  }
  @media (max-width: 480px) {
    .home-actions .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home .animate-in { animation: none; }
  }
</style>

<main class="home">
  <section class="home-hero animate-in" aria-labelledby="home-title">
    <p class="home-badge"><i data-lucide="sparkles" aria-hidden="true"></i><%= t('home.hero.badge') %></p>
    <h1 class="home-title" id="home-title"><%- rich(youtube ? 'home.hero.title' : 'home.hero.titleNoYoutube', { em: '<span class="home-title-accent">', emEnd: '</span>' }) %></h1>
    <p class="home-lead"><%= t(youtube ? 'home.hero.lead' : 'home.hero.leadNoYoutube') %></p>
    <div class="home-actions">
      <a href="<%= cta.href %>" class="<%= cta.className %>"><%- cta.icon %><%= cta.label %></a>
      <a href="/tutorial" class="btn btn-secondary"><i data-lucide="book-open" aria-hidden="true"></i><%= t('nav.setupGuide') %></a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-features-title">
    <div class="home-section-head animate-in animate-in-delay-1">
      <h2 id="home-features-title"><%= t('home.features.title') %></h2>
      <p><%= t('home.features.lead') %></p>
    </div>
    <div class="home-grid">
      <% cards.forEach(function (card, i) { %>
        <article class="card home-card home-tone-<%= card.tone %><%= card.wide ? ' home-card-wide' : '' %> animate-in animate-in-delay-<%= Math.min(i + 1, 4) %>">
          <div class="home-card-head">
            <span class="home-icon"><i data-lucide="<%= card.icon %>" aria-hidden="true"></i></span>
            <h3><%= t(card.title) %></h3>
          </div>
          <ul class="home-list">
            <% card.items.forEach(function (item) { %>
              <li><i data-lucide="check" aria-hidden="true"></i><span><%= t(item) %></span></li>
            <% }); %>
          </ul>
        </article>
      <% }); %>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-how-title">
    <div class="home-section-head">
      <h2 id="home-how-title"><%= t('home.how.title') %></h2>
    </div>
    <ol class="home-steps">
      <% steps.forEach(function (step, i) { %>
        <li class="card home-step">
          <span class="step-number" aria-hidden="true"><%= i + 1 %></span>
          <h3><%= t(step[0]) %></h3>
          <p><%= t(step[1]) %></p>
        </li>
      <% }); %>
    </ol>
    <p class="home-guide"><a href="/tutorial"><%= t('home.how.guide') %><i data-lucide="arrow-right" aria-hidden="true"></i></a></p>
  </section>

  <section class="home-closing" aria-labelledby="home-closing-title">
    <h2 id="home-closing-title"><%= t('home.closing.title') %></h2>
    <p><%= t('home.closing.text') %></p>
    <div class="home-actions">
      <a href="<%= cta.href %>" class="<%= cta.className %>"><%- cta.icon %><%= cta.label %></a>
    </div>
  </section>

  <form method="POST" action="/set-language" class="home-lang" aria-labelledby="home-lang-label">
    <span class="home-lang-label" id="home-lang-label"><i data-lucide="globe" aria-hidden="true"></i><%= t('nav.language') %></span>
    <% SUPPORTED_LANGS.forEach(function (code) { %>
      <button type="submit" name="lang" value="<%= code %>" lang="<%= code %>" class="home-lang-btn"<%- code === lang ? ' aria-current="true"' : '' %>><%= t('lang.' + code) %></button>
    <% }); %>
  </form>
</main>

<%- include('footer') %>
